	year = {2026},
	journal = {Proceedings of the 2026 ElCon Conference of Young Researchers in Communication and Networking, Signal Processing and Analysis, Biomedical and Environmental Engineering, ElCon-CN 2026},
	pages = {317 - 320},
	doi = {10.1109/ElCon-CN69892.2026.11413892},
	url = {https://www.scopus.com/pages/publications/105036737332?origin=resultslist},
	abstract = {Class II malocclusion is a common dentofacial anomaly in orthodontics, and its diagnosis depends on cephalometric analysis of craniofacial structures. Traditional cephalometric methods require manual point marking and angle calculation on lateral cephalometric X-ray images, which is time-consuming and may involve subjective bias. In this study, we propose a simple AI-assisted approach using a large language model (LLM) for cephalometric measurement and preliminary diagnostic support. First, key anatomical landmarks are manually or automatically marked on X-ray images and converted into two-dimensional coordinates. Then, these coordinates are input to the LLM, which calculates essential cephalometric angles (such as ANB, SNB, and U1-SN) and provides evaluation suggestions based on quantitative values. This process forms a standardized pipeline from landmark marking to angle measurement and diagnostic assistance. © 2026 IEEE.},
