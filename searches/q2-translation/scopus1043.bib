@CONFERENCE{Ayon2026237,
	author = {Ayon, Ragib Shahariar and Ahmed, Shibbir},
	title = {SpecPylot: Python Specification Generation with Large Language Models},
	year = {2026},
	journal = {FSE Companion 2026 - Proceedings of the 34th ACM International Conference on the Foundations of Software Engineering},
	pages = {237 - 241},
	doi = {10.1145/3803437.3806427},
	url = {https://www.scopus.com/pages/publications/105045811902?origin=resultslist},
	abstract = {Automatically generating formal specifications could reduce the effort needed to improve program correctness, but in practice, this is still challenging. Many developers avoid writing contracts by hand, which limits the use of automated verification tools. Recent large language models (LLMs) can generate specifications from code, but these specifications often fail in terms of verification. The reason is syntax errors, overly strict constraints, or mismatches with program behavior. We present SpecPylot, a Python tool that synthesizes executable specifications for Python programs as icontract annotations and checks them using CrossHair's symbolic execution. The tool relies on LLMs to propose candidate contracts and uses CrossHair to validate them. When CrossHair finds a concrete counterexample, SpecPylot updates only the generated contracts and leaves the program itself untouched. In addition, the tool can produce coverage-driven pytest stubs and keep detailed execution artifacts that are useful during debugging. Overall, the evaluation indicates that SpecPylot is able to generate CrossHair-compatible contracts for most programs, but it also highlights the practical limits introduced by bounded symbolic exploration and differences in LLM behavior. © 2026 Copyright held by the owner/author(s).},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Porshnev2026,
	author = {Porshnev, Alexander and Kiy, Kevin Dirk and O'Donoghue, Diarmuid and Singh, Manokamna and Wingfield, Cai and Lynott, Dermot},
