@ARTICLE{Sheridan2025350,
	author = {Sheridan, Oisín and Becker, Leandro Buss and Farrell, Marie and Luckcuck, Matt and Monahan, Rosemary},
	title = {Sharper Specs for Smarter Drones: Formalising Requirements with FRET},
