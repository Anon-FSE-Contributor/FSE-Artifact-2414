}

@ARTICLE{Qasim2026,
	author = {Qasim, Kaleem Ullah and Zhang, Jiashu},
	title = {MARBLE: A Multi-Agent Rule-Based LLM Reasoning Engine for Accident Severity Prediction},
	year = {2026},
	journal = {IEEE Transactions on Intelligent Transportation Systems},
	pages = {},
	doi = {10.1109/TITS.2026.3715630},
	url = {https://www.scopus.com/pages/publications/105048641512?origin=resultslist},
	abstract = {Accident severity prediction is essential for emergency response and traffic management, yet faces challenges in balancing accuracy, interpretability, and robustness to class imbalance. Machine learning approaches typically rely on synthetic oversampling techniques like SMOTE, achieving 72-91% accuracy but limiting transparency. Recent large language model prompting strategies show promise but struggle with structured tabular data, reaching approximately 30% accuracy due to difficulties in reasoning over flat feature representations and long context. We introduce MARBLE, a decomposed inference architecture that addresses these limitations through semantic task decomposition. MARBLE distributes prediction across specialized small language model agents, each reasoning over coherent feature subsets (spatial, environmental, temporal, geo) via domain focused prompts. A machine learning agent provides complementary statistical inference, and predictions are fused through confidence weighted coordination that accounts for class rarity. On UK and US accident datasets with natural class imbalance, MARBLE achieves 89.5-89.8% accuracy without synthetic data augmentation, outperforming traditional ML by 42 + points, specialized deep learning by 35 + points, and prompting methods by 57 + points. Critically, MARBLE surpasses SMOTE-augmented baselines by 8-17 points while maintaining interpretability through structured agent outputs and reasoning traces. These results demonstrate that semantic decomposition enables accurate and explainable prediction in safety critical transportation applications. © 2000-2011 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access}
}

