	url = {https://www.scopus.com/pages/publications/85192837407?origin=resultslist},
	abstract = {Software requirements specification describes users’ needs and expectations on some target system. Requirements documents are typically represented by unstructured natural language text. Such texts are the basis for the various subsequent activities in software development, such as software analysis and design. As part of software analysis, domain models are made that describe the key concepts and relations between them. Since the analysis process is performed manually by business analysts, it is time-consuming and may introduce mistakes. Recently, researchers have worked toward automating the synthesis of domain models from textual software requirements. Current studies on this topic have limitations in terms of the volume and heterogeneity of experimental datasets. To remedy this, we provide a curated dataset of software requirements to be utilized as a benchmark by algorithms that transform textual requirements documents into domain models. We present a detailed evaluation of two text-to-model approaches: one based on a large-language model (ChatGPT) and one building on grammatical rules (txt2Model). Our evaluation reveals that both tools yield promising results with relatively high F-scores for modeling the classes, attributes, methods, and relationships, with txt2Model performing better than ChatGPT on average. Both tools have relatively lower performance and high variance when it comes to the relation types. We believe our dataset and experimental evaluation pave to way to advance the field of automated model generation from requirements. © The Author(s), under exclusive licence to Springer-Verlag GmbH Germany, part of Springer Nature 2024.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 23; All Open Access; Green Open Access}
}

@CONFERENCE{Danso2026152,
	author = {Danso, Priscilla Kyei and Hasan, Mohammad Saqib and Balasubramanian, Niranjan and Chowdhury, Omar},
	title = {Syntax Is Easy, Semantics Is Hard: Evaluating LLMs for LTL Translation},
	year = {2026},
	journal = {SecDev 2026 - Proceedings of the 2026 ACM Secure Development Conference, Co-located with FSE 2026},
	pages = {152 - 168},
	doi = {10.1145/3805773.3806005},
	url = {https://www.scopus.com/pages/publications/105045273533?origin=resultslist},
	abstract = {Propositional Linear Temporal Logic (LTL) is a popular formalism for specifying desirable requirements and security and privacy policies for software, networks, and systems. Yet expressing such requirements and policies in LTL remains challenging because of its intricate semantics. Since many security and privacy analysis tools require LTL formulas as input, this difficulty places them out of reach for many developers and analysts. Large Language Models (LLMs) could broaden access to such tools by translating natural language fragments into LTL formulas. This paper evaluates that premise by assessing how effectively several representative LLMs translate assertive English sentences into LTL formulas. Using both human-generated and synthetic ground-truth data, we evaluate effectiveness along syntactic and semantic dimensions. The results reveal three findings: (1) in line with prior findings, LLMs perform better on syntactic aspects of LTL than on semantic ones; (2) they generally benefit from more detailed prompts; and (3) reformulating the task as a Python code-completion problem substantially improves overall performance. We also discuss challenges in conducting a fair evaluation on this task and conclude with recommendations for future work. © 2026 Copyright held by the owner/author(s).},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@CONFERENCE{Curto202610,
	author = {Curto, Hayala and Semini, Laura and Marques-Neto, Humberto T.},
	title = {Using Distinct LLMs to Generate an Initial Software Functional Requirements List in Multiple Interactions},
	year = {2026},
	journal = {Proceedings - 2026 IEEE/ACM Requirements Engineering for AI-powered SoftwarE, RAISE 2026},
	pages = {10 - 18},
	doi = {10.1145/3786174.3788352},
	url = {https://www.scopus.com/pages/publications/105046494565?origin=resultslist},
	abstract = {To assist analysts during the elicitation phase, we propose orchestrating Large Language Models (LLMs) to generate an initial list of requirements from an early description of the target system, which can serve as a starting point for stakeholder interaction rather than starting from scratch. In this paper, we examine which orchestration performs best, specifically, by comparing: (i) single-LLM; (ii) multi-LLM; (iii) multi-LLM with feedback rounds; and (iv) multi-LLM with feedback rounds and an improvement stage. We present a structured method that orchestrates five complementary LLMs in iterative feedback loops to construct initial requirement lists. In each iteration, the models generate, consolidate, and refine candidate requirements, progressively improving coverage. Given the variability in outputs across models for the same prompt, running multiple LLMs concurrently can produce a more comprehensive requirements artifact at this early stage of the software process - analogous to consulting various domain experts. The procedure begins with a zero-shot round to surface candidate requirements using the selected LLMs, followed by successive prompt rounds that iteratively refine and enhance the emerging lists. We based the assessment on public Software Requirement Specification documents (SRSs), and we yielded moderate similarity to ground truth, with most gains achieved within the first two interactions, indicating early convergence rather than continuous improvement. © 2026 Copyright held by the owner/author(s).},
