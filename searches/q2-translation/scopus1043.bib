	journal = {Lecture Notes in Computer Science},
	volume = {16697 LNCS},
	pages = {286 - 304},
	doi = {10.1007/978-3-032-30693-7_19},
	url = {https://www.scopus.com/pages/publications/105045588778?origin=resultslist},
	abstract = {Requirement-driven testing of Simulink models is crucial for ensuring safety early in development, yet domain engineers often struggle to construct comprehensive test cases or translate natural-language requirements into formal specifications. To address this challenge, we propose LLM-guided Requirement Scenario-Based Testing (RST-LLM), where an LLM serves as a semantic transformer that converts requirements into structured testing artifacts rather than directly producing test cases. We introduce a hierarchical Action–Scenario abstraction. The LLM extracts typical actions with signal-level constraints and composes requirement-related scenarios as ordered action sequences. The scenarios are first enhanced and instantiated, and executable test cases are subsequently generated through constraint-guided search. Experimental results show that RST-LLM improves model coverage and achieves stronger fault-detection capability compared with adaptive random testing and direct LLM-based test generation. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2027.},
