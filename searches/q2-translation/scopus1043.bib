@CONFERENCE{Katic2024159,
	author = {Katic, Martina Asenbrener and Candrlic, Sanja and Koch, Marina Rauker},
	title = {Transformation of Natural Language Interrogative Sentences into Question Formalized Node of Knowledge (QFNOK) Record},
	year = {2024},
	journal = {Proceedings of International Conference on Smart Systems and Technologies, SST 2024},
	pages = {159 - 164},
	doi = {10.1109/SST61991.2024.10755240},
	url = {https://www.scopus.com/pages/publications/85212865281?origin=resultslist},
	abstract = {The conceptual framework Node of Knowledge (NOK) enables the storage of declarative and interrogative sentences in a formalized record within a relational database. Declarative sentences in natural language that express knowledge are transformed into Formalized Node of Knowledge (FNOK) records to facilitate their storage in a relational database. Similarly, interrogative sentences in natural language, which inquire about the knowledge expressed in declarative sentences are converted into a formalized NOK record for questions, called Question Formalized Node of Knowledge (QFNOK). This conversion allows these questions to be stored in a relational database and retrieved for answers. This paper describes the rules for converting interrogative sentences in Croatian and English into formalized QFNOK records, providing multiple examples for each rule. This research represents a step toward the development of a QA system based on the NOK conceptual framework. Initial tests demonstrated a 93% accuracy rate in both languages. © 2024 IEEE.},
