@CONFERENCE{Rojas2010100,
	author = {Rojas, Allan Berrocal and Sliesarieva, Gabriela Barrantes},
	title = {Automated Detection of Language Issues Affecting Accuracy, Ambiguity and Verifiability in Software Requirements Written in Natural Language},
	year = {2010},
	journal = {Young Investigators Workshop on Computational Approaches to Languages of the Americas, Proceedings},
	pages = {100 - 108},
	url = {https://www.scopus.com/pages/publications/84965103654?origin=resultslist},
