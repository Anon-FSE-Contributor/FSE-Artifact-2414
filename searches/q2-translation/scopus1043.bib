@CONFERENCE{Luo2026484,
	author = {Luo, Zijing},
	title = {Tracker-LLM: Enhancing Visual Object Tracking via Bi-directional Chain-of-Thought Reasoning and Spatio-Temporal Memory},
	year = {2026},
	journal = {2026 International Conference on Generative Artificial Intelligence and Information Security, GAIIS 2026},
	pages = {484 - 487},
	doi = {10.1109/GAIIS69281.2026.11519166},
	url = {https://www.scopus.com/pages/publications/105041677068?origin=resultslist},
	abstract = {While Vision-Language (VL) tracking has shown promise in improving tracking versatility by integrating linguistic cues, existing methods often rely on static and potentially ambiguous textual descriptions. Furthermore, these frameworks fail to leverage the deep, multi-step reasoning capabilities inherent in modern Multimodal Large Language Models (MLLMs). To address these limitations, we propose Tracker-LLM, a novel tracking framework that treats the MLLM as an active logical reasoning hub rather than a passive text generator. We introduce a Bi-directional Chain-of-Thought (Bi-CoT) reasoning mechanism that empowers the model to autonomously derive and refine localization logic based on real-time tracking feedback. To bridge the gap between high-level abstract semantics and low-level granular visual features, we design an Asynchronous Spatio-Temporal Memory (ASTM) engine. This engine alleviates the problem of semantic obsolescence caused by target appearance evolution and environmental shifts in long-term tracking by maintaining and updating a lightweight memory pool. Furthermore, a Dynamic Background-Sensitive Awareness (DBSA) strategy is proposed to refine background descriptions iteratively through the mining of hard distractors. Extensive experiments on several mainstream benchmarks demonstrate that Tracker-LLM significantly enhances tracking robustness and precision, particularly in complex scenarios involving severe occlusions, illumination variations, and drastic appearance changes, while achieving an average end-to-end latency of 6.89 ms (145.1 FPS) and a peak speed of 215.1 FPS on GPU. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Grigorev202518489,
	author = {Grigorev, Danil S. and Kovalev, Alexey K. and Panov, Aleksandr I.},
	title = {VerifyLLM: LLM-Based Pre-Execution Task Plan Verification for Robots},
	year = {2025},
	journal = {IEEE International Conference on Intelligent Robots and Systems },
	pages = {18489 - 18496},
	doi = {10.1109/IROS60139.2025.11246320},
	url = {https://www.scopus.com/pages/publications/105029935815?origin=resultslist},
	abstract = {In the field of robotics, researchers face a critical challenge in ensuring reliable and efficient task planning. Verifying high-level task plans before execution significantly reduces errors and enhance the overall performance of these systems. In this paper, we propose an architecture for automatically verifying high-level task plans before their execution in simulator or real-world environments. Leveraging Large Language Models (LLMs), our approach consists of two key steps: first, the conversion of natural language instructions into Linear Temporal Logic (LTL), followed by a comprehensive analysis of action sequences. The module uses the reasoning capabilities of the LLM to evaluate logical coherence and identify potential gaps in the plan. Rigorous testing on datasets of varying complexity demonstrates the broad applicability of the module to household tasks. We contribute to improving the reliability and efficiency of task planning and addresses the critical need for robust pre-execution verification in autonomous systems. The project page is available at https://verifyllm.github.io.  © 2025 IEEE.},
