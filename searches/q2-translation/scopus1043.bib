@CONFERENCE{Mulyadi2024445,
	author = {Mulyadi, Hartawan Bahari and Sarno, Riyanarto and Septiyanto, Abdullah Faqih and Sunaryono, Dwi},
	title = {Knowledge-Graph NLP Assistant for Mitigate Norm Violations: Live Chat Moderation Study},
	year = {2024},
