	author = {Panigo, Ailén and Bankoff, Kristian Petkoff and Pasini, Ariel and Pesado, Patricia},
	title = {Tracking the Evolution of Large Language Models in Requirements Elicitation and Analysis},
	year = {2026},
	journal = {Communications in Computer and Information Science},
