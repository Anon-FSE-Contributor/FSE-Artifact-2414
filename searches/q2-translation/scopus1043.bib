	url = {https://www.scopus.com/pages/publications/105048744354?origin=resultslist},
	abstract = {Temporal Knowledge Graph Question Answering (TKGQA) aims to answer time-sensitive questions by leveraging factual information from Temporal Knowledge Graphs (TKGs). While previous studies have employed pre-trained TKG embeddings or graph neural networks to inject knowledge, they fail to fully capture the complex semantics of temporal constraints. Recently, Large Language Models (LLMs) have shown remarkable progress, benefiting from their strong semantic understanding and reasoning generalization capabilities. However, their temporal reasoning ability remains limited, often suffering from hallucinations and knowledge gaps. To address these limitations, we propose PoK, a Plan of Knowledge framework equipped with a contrastive temporal retriever. Specifically, the Plan of Knowledge module decomposes a complex temporal question into a sequence of sub-objectives based on predefined operators, providing intermediate guidance for reasoning exploration at the reasoning level. In parallel, we construct a Temporal Knowledge Store (TKS) with a contrastive retrieval framework, enabling the model to retrieve semantically and temporally aligned facts from TKGs, thereby enhancing temporal modeling at the representation level. By combining structured planning with temporal knowledge retrieval, PoK improves the interpretability and factual consistency of temporal reasoning. Extensive experiments on four benchmark TKGQA datasets show that PoK significantly improves retrieval precision and reasoning accuracy, surpassing state-of-the-art methods by up to 35.3 percentage points. © 2026 IEEE. All rights reserved.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
