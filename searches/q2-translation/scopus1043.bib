	author = {Ghosh, Shalini and Elenius, Daniel and Li, Wenchao and Lincoln, Patrick and Shankar, Natarajan and Steiner, Wilfried},
	title = {ARSENAL: Automatic requirements specification extraction from natural language},
	year = {2016},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
	volume = {9690},
	pages = {41 - 46},
	doi = {10.1007/978-3-319-40648-0_4},
	url = {https://www.scopus.com/pages/publications/84976616720?origin=resultslist},
	abstract = {Requirements are informal and semi-formal descriptions of the expected behavior of a complex system from the viewpoints of its stakeholders (customers, users, operators, designers, and engineers). However, for the purpose of design, testing, and verification for critical systems, we can transform requirements into formal models that can be analyzed automatically. ARSENAL is a framework and methodology for systematically transforming natural language (NL) requirements into analyzable formal models and logic specifications. These models can be analyzed for consistency and implementability. The ARSENAL methodology is specialized to individual domains, but the approach is general enough to be adapted to new domains. © Springer International Publishing Switzerland 2016.},
