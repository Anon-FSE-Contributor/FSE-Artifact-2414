@ARTICLE{Ding20261417,
	author = {Ding, Lianhong and Ding, Na and Shi, Peng},
	title = {TempRAA: temporal relation-aware alignment for enhancing LLMs reasoning in time-sensitive knowledge graph question answering},
	year = {2026},
	journal = {Journal of Intelligent Information Systems},
	volume = {64},
	number = {4},
