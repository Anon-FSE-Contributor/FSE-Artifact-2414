@ARTICLE{Dang2026,
	author = {Dang, Quoc Phu and Tran-Truong, Phat T. and Vu, Duc-Ly and Nguyen, Long S.T. and Vo, Quynh T.N. and Quan, Tho},
	title = {Enhancing large language model performance for automatic zero-shot multiple-choice question answering via single-token logit prompting},
	year = {2026},
	journal = {Computers and Education: Artificial Intelligence},
	volume = {10},
