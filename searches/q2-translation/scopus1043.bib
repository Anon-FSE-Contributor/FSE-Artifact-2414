	pages = {549 - 554},
	doi = {10.1109/IISEC69317.2026.11418463},
	url = {https://www.scopus.com/pages/publications/105035991100?origin=resultslist},
	abstract = {Hallucination remains one of the most significant challenges limiting the reliability and safety of Large Language Models (LLMs), particularly in high-stakes or knowledge-sensitive tasks. While existing work has largely emphasized external validation or post-hoc correction, comparatively few studies examine hallucination propensity through the internal mechanisms of LLMs. To address this gap, we introduce a fully white-box benchmark and curated dataset for evaluating hallucination risk in Turkish LLMs using intrinsic model signals. Building on logit-based uncertainty estimation, we quantify internal confidence via perplexity, logit entropy, and token-level entropy dynamics, and further extract representational cues from attention and hidden layers. We propose two complementary intrinsic metrics, information entropy and edge attention entropy, that capture distinct aspects of internal model behavior. Evaluating seven widely deployed Turkish LLMs from both academic and industrial sources, we show that intrinsic metrics consistently separate models with stable internal representations from those exhibiting higher hallucination susceptibility. Among the evaluated models, Novus-7B achieved the highest information entropy (0.5727), indicating comparatively higher internal confidence in next-token predictions. Kumru-2B attained the highest edge attention entropy (0.5479) and simultaneously achieved the best accuracy (0.6250) on the curated benchmark, suggesting stronger alignment between attention stability and factual correctness. Moreover, the joint analysis of uncertainty signals and representation-level coherence reveals systematic divergences between internal confidence and external accuracy, indicating that accuracy alone is insufficient to characterize hallucination risk. The proposed benchmark provides a transparent, reproducible, and model-agnostic framework for intrinsic hallucination assessment and constitutes the first comprehensive white-box evaluation tailored specifically to Turkish LLMs. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

