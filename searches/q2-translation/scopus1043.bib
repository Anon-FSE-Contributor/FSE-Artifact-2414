@CONFERENCE{Zhen20261132,
	author = {Zhen, Wenyu and Huang, Minhuan and Li, Xiang and Nie, Yuanping and Wan, Yuxian and Zhong, Fan},
	title = {SyzScout: Automated Syzkaller Specification Generation via LLM-Based Agents},
	year = {2026},
	journal = {2026  the 11th International Conference on Computer and Communication Systems, ICCCS 2026},
	pages = {1132 - 1141},
	doi = {10.1109/ICCCS69761.2026.11613509},
	url = {https://www.scopus.com/pages/publications/105047082535?origin=resultslist},
	abstract = {The security of operating system kernels underpins the reliable operation of the entire software stack. Kernel fuzzing has emerged as a primary technique for detecting kernel vulnerabilities, yet its effectiveness hinges on precise formal descriptions of kernel interfaces, known as system call specifications. While prior work has explored automated specification generation through static analysis, dynamic analysis, and direct large language model (LLM) inference, the process remains largely manual, leaving a substantial number of driver interfaces inadequately covered. In this paper, we propose SyzScout, an automated system call specification generation system powered by LLM-based agents. SyzScout operates through a three-phase closed-loop workflow comprising code exploration, specification synthesis, and compilation-driven iterative repair. The agent retrieves kernel source code on demand within a bounded context window, performs semantic reasoning over interface definitions, and leverages compiler feedback to iteratively correct specification errors. We evaluate SyzScout on Linux kernel v6.12 and show that Syzkaller equipped with SyzScout-generated specifications achieves a 4.7% increase in basic block coverage over the vanilla configuration, and uniquely triggers 9 kernel crashes, of which 4 have been confirmed by maintainers and 3 have received patches.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Tian20264056,
	author = {Tian, Kai and Chen, Xi and Wei, Fushan and Gu, Chunxiang and Chen, Maosong and Guo, Jiaxing},
	title = {LLM-assisted Verification of Protocol Implementations for Logic Flaws Using TLA+},
	year = {2026},
	journal = {Proceedings of the International Conference on Computer Supported Cooperative Work in Design, CSCWD},
	number = {2026},
