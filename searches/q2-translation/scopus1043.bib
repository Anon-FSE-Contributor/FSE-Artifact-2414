	note = {Cited by: 2}
}

@CONFERENCE{Silveira20241685,
	author = {Silveira, Wellington and Mendonça, Luca and De Bem, Rodrigo},
	title = {LLM-based Sign Language Production},
	year = {2024},
	journal = {Proceedings - 2024 International Conference on Machine Learning and Applications, ICMLA 2024},
	pages = {1685 - 1690},
	doi = {10.1109/ICMLA61862.2024.00260},
	url = {https://www.scopus.com/pages/publications/105000943158?origin=resultslist},
	abstract = {Sign language is an effective means of communication for individuals with different degrees of hearing impairment. Assistive technologies are a significant ally in the social inclusion of people from these groups. Recent advancements in natural language models and high-definition image generation emerged as a novel, non-intrusive approach for tasks related to sign language recognition (SLR), translation (SLT), and production (SLP). This work introduces a novel sign language production approach based on Large Language Models (LLMs) capable of translating text to signs, which are then synthesized into sequences of images. Our method is tested with two LLMs, the LLaMA-7B-hf (quantized) and the Vicuna-7B. Experiments performed on two sign language datasets, the RWTH-PHOENIX-Weather, and the SynLibras-Pose, have shown promising results for this cross-modal application of LLMs.  © 2024 IEEE.},
