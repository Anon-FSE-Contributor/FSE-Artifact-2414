@CONFERENCE{Okour2026,
	author = {Okour, Saif and Aljamal, Mahmoud and Aljaidi, Mohammad and Khassawneh, Bashar and Hadi, Wael and Alsarhan, Ayoub and Bin Sulaiman, Rejwan},
	title = {An AI Agent Using NLP for Automating Documentation and Formal Specification Generation in the Software Development Life Cycle},
	year = {2026},
