@CONFERENCE{Cardia202623,
	author = {Cardia, Marco and Angileri, Letizia and Poggianti, Camilla and Leporini, Barbara},
	title = {Human vs LLM-Generated Alt Text for STEM Image Accessibility: A Comparative Study},
