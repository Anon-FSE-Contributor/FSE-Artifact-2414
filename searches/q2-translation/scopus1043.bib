@CONFERENCE{Panchal2025,
	author = {Panchal, Vikas and Kumar, Raj and Motghare, Manish and Shelke, Nilesh and Londhe, Gaurav and Kagi, Darshan S},
	title = {A Dependency Parser LLM Prolog Pipeline for Story Understanding},
	year = {2025},
	journal = {2025 IEEE 3rd Global Conference on Wireless Computing and Networking, GCWCN 2025},
	pages = {},
	doi = {10.1109/GCWCN66157.2025.11448316},
	url = {https://www.scopus.com/pages/publications/105037332490?origin=resultslist},
	abstract = {Neuro-symbolic approaches promise both the flexibility of language models and the rigor of formal logic. We introduce StoryLogic, an end-to-end pipeline that [1] extracts event graphs via graph-theoretic dependency parsing, [2] derives causal inferences with a fine-tuned GPT-4 LLM, [3] enforces temporal-causal constraints in a Prolog engine, and [4] measures discourse coherence and fluency through graph connectivity and Shannon entropy. Evaluated on ROCStories and NarrativeQA, StoryLogic yields a 15 pp. improvement in logical coherence and a 12 % gain in BLEU-1 over neural-only baselines. These results suggest that tightly coupling symbolic checks with neural inference leads to more reliable narrative understanding.The complete implementation and resources for this work are available in the official GitHub repository. GitHub.  © 2025 IEEE.},
