@ARTICLE{Yang2027491,
	author = {Yang, Lei and Huang, Yanhong and Shi, Jianqi and Cai, Haibin and Guo, Xin and Wei, Xian},
	title = {Resolving Natural Language Ambiguity for Verified Code Generation: A Two-Stage LLM Framework},
	year = {2027},
	journal = {Lecture Notes in Computer Science},
	volume = {16664 LNCS},
	pages = {491 - 502},
	doi = {10.1007/978-981-92-3426-4_41},
	url = {https://www.scopus.com/pages/publications/105047073334?origin=resultslist},
	abstract = {Bridging the semantic gap between unstructured, ambiguous natural language (NL) and rigorous mathematical logic remains a fundamental challenge in computational linguistics and AI-driven software engineering. While Large Language Models (LLMs) excel at general code synthesis, generating formally verified programs directly from NL often fails due to two hurdles: the inherent semantic ambiguity in human intent that leads to ill-defined logical contracts, and the complex reasoning required to synthesize mathematical loop invariants. To address these natural language processing (NLP) and AI system challenges, this paper presents EEDG (End-to-End Dafny Generation), a novel two-stage LLM framework. First, we introduce a fuzzy semantic discrimination mechanism utilizing test-case anchoring to autonomously resolve NL ambiguities, effectively translating underspecified human intents into strict, unambiguous programmatic contracts. Second, we propose LIG-AID, an intelligent agent toolchain that synergizes LLM reasoning with symbolic verifier feedback to autonomously repair and fulfill complex structural proofs. Furthermore, we present DafnyHeart, a diverse benchmark pairing ambiguous NL descriptions with verifiable Dafny programs. Extensive experiments demonstrate that EEDG significantly mitigates natural language ambiguity and vastly improves the success rate of AI systems in generating strictly verified programs autonomously. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2027.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

