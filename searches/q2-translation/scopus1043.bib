@CONFERENCE{Netz2025636,
	author = {Netz, Lukas and Kampe, Finn and Reimer, Jan and Rumpe, Bernhard},
	title = {Unintended Changes: How LLMs Corrupt and Correct Textual Models},
	year = {2025},
	journal = {Proceedings - 2025 ACM/IEEE 28th International Conference on Model Driven Engineering Languages and Systems Companion, MODELS-C 2025},
	pages = {636 - 645},
	doi = {10.1109/MODELS-C68889.2025.00087},
	url = {https://www.scopus.com/pages/publications/105030457076?origin=resultslist},
	abstract = {This work evaluates to what degree AI-based modeldriven software development approaches may unintentionally alter parts of a model, potentially affecting its semantics, particularly when the model is defined in a domain-specific language unfamiliar to the LLM, and discusses to what degree the perplexity metric can be used to indicate susceptible modeling languages. Although much work has focused on evaluating the correctness of AI-based model creation, it remains important to assess whether and to what extent LLMs introduce unintended modifications in parts of the input model that they are merely expected to reproduce. Previous research has primarily focused on the success of programming and modeling tasks using AI, such as achieving syntactic and semantic correctness. In contrast, this work investigates the side effects of AI usage, specifically the introduction of unintended modifications during iterative modeling processes. We evaluate the likelihood of error introduction in an AI-based modeling approach for uncommon DSLs and use the perplexity-metric to identify error prone elements in the model. We use our own modeling language for class diagrams CD4A, an LLM that is not trained on this DSL and prompt it with simple modeling tasks. Next, we measure additional changes to the model that are not related to the given modeling task. We show that AI-driven Modeling approaches need to also focus on side effects of iterative LLM usage with unfamiliar modeling languages, and demonstrate how these risks can be identified. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Li2025548,
	author = {Li, Mingzhu and Qin, Weihang and Tang, Zijing and Fang, Xuri and He, Tao and Cao, Xiaoming},
	title = {Automating SSRL Detection in Asynchronous OCL via LLMs},
	year = {2025},
	journal = {2025 7th International Conference on Computer Science and Technologies in Education, CSTE 2025},
	pages = {548 - 551},
	doi = {10.1109/CSTE64638.2025.11092245},
	url = {https://www.scopus.com/pages/publications/105013539646?origin=resultslist},
	abstract = {Socially Shared Regulation of Learning (SSRL) in online collaborative learning (OCL) presents significant challenges due to the complexity of asynchronous interactions and the limitations of conventional content analysis methods. However, existing tools struggle to scale effectively with the heterogeneous nature of peer discussions, which are context-dependent and linguistically nuanced. This study introduces a novel, modular, intelligent coding system that integrates SSRL theory with large language models (LLMs), enabling automated content analysis. Using 1,380 peer-discussion entries from a 16-week undergraduate course, we evaluated three LLMs (ChatGPT-4o, ChatGPT-o1, and DeepSeek-R1) with a three-stage experimental pipeline: Zero-shot, Few-shot, and Few-shot Chain-of-Thought prompting. Results showed that Few-shot Chain-of-Thought prompting improved contextual reasoning, with DeepSeek-R1 achieving 83.3% accuracy in phase identification, leveraging attention-based modeling of implicit linguistic cohesion in collaborative discussions. The system innovatively encodes SSRL's pedagogical constructs into hierarchical prompt templates, allowing for automatic detection of regulatory patterns while mitigating semantic ambiguity. A case study further demonstrates its effectiveness in distinguishing between surface-level consensus and genuine co-construction behaviors. This work pioneers the integration of SSRL frameworks with generative AI, offering a scalable tool for SSRL regulation analysis in educational settings. Future research should focus on lightweight domain adaptation techniques, such as LoRA fine-tuning, and hybrid models combining cognitive diagnostics to enhance interpretability and bridge the gap between AI outputs and expert judgment in content analysis. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

