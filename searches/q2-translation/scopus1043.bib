	year = {1995},
	journal = {Proceedings of the IEEE International Conference on Systems, Man and Cybernetics},
	volume = {1},
	pages = {696 - 701},
	url = {https://www.scopus.com/pages/publications/0029492642?origin=resultslist},
	abstract = {A formal method to determine the style of sentences is proposed. Sentences generated by a human are expressed using various ways depending on his states of mind, even if he utters his same thoughts. Selecting one of adverbs which is suitable for a situation is one of these problems. Especially in Japanese, what a speaker wants to tell a hearer is sometimes determined only by a kind of adverbs. If natural language interfaces have an ability to handle styles of sentences or adverbs so as to adapt to a situation, they would become friendly interfaces, because they must surely understand the intention of user. In this paper, we describe the nature of problem and propose the formalization of expression of sentence using modal logic with temporal information, then evaluate it by comparing sentences of the human and the system. As a result, the system could generate sentences which are the same as the human did. We consider that intuitively understandable sentences for friendly natural language interfaces were generated by information about the human mind.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
