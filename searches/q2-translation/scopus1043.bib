@CONFERENCE{Kavin20261898,
	author = {Kavin, Rajan G and Micheal, Berdinanth M and Shahul, Hamead H},
	title = {POSTER: A Verifiable Framework for Translating Natural Language Network Policies to P4 Code},
	year = {2026},
	journal = {ASIA CCS 2026 - Proceedings of the 21st ACM ASIA Conference on Computer and Communications Security},
	pages = {1898 - 1900},
	doi = {10.1145/3779208.3804886},
	url = {https://www.scopus.com/pages/publications/105042483512?origin=resultslist},
	abstract = {Programmable data planes enable line-rate enforcement of network security policies, yet translating high-level natural language intent into correct and safe P4 programs remains challenging. Manual policy translation is error-prone, while existing LLM-based approaches generate syntactically valid code without guarantees of semantic correctness, temporal safety, or explainability. We present a verification-first framework that translates natural language network policies into provably correct P4 programs. The framework introduces Lucid, a structured intermediate language that decouples probabilistic intent interpretation from deterministic compilation, improving synthesis stability and efficiency. Natural language policies are additionally translated into Linear Temporal Logic (LTL) specifications, enabling formal verification of the generated P4 programs using the P4tv temporal verification framework. Our system enforces transaction-level temporal semantics and produces concrete counterexamples upon policy violations, supporting both formal correctness guarantees and human-understandable explanations. Experimental results demonstrate reduced token and KV-cache usage compared to direct NL-to-P4 generation, along with scalable verification of stateful data-plane policies. © 2026 Copyright held by the owner/author(s).},
