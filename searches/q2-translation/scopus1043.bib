}

@CONFERENCE{Chaparala2024576,
	author = {Chaparala, Kaavya and Zarrella, Guido and Fischer, Bruce Torres and Kimura, Larry and Jones, Oiwi Parker},
	title = {Mai Ho'omauna i ka 'Ai: Language Models Improve Automatic Speech Recognition in Hawaiian},
	year = {2024},
	journal = {Proceedings of Machine Learning Research},
	volume = {262},
	pages = {576 - 583},
	url = {https://www.scopus.com/pages/publications/85216761695?origin=resultslist},
