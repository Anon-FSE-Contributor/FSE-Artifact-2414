	author = {Parrales-Bravo, Franklin and Gomez-Rodriguez, Victor and Cevallos-Torres, Lorenzo},
	title = {CRUDE (CRUD + Entity) Structure to Help Unambiguous Functional Requirement Specification in Natural Language},
	year = {2024},
