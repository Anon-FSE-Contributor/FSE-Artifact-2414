@ARTICLE{Carvalho2015283,
	author = {Carvalho, Gustavo and Barros, Flávia and Carvalho, Ana and Cavalcanti, Ana and Mota, Alexandre and Sampaio, Augusto},
	title = {NAT2TEST tool: From natural language requirements to test cases based on CSP},
	year = {2015},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
