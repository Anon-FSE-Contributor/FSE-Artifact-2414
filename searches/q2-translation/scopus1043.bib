	author = {Fathallah, Nadeen and Das, Arunav and De Giorgis, Stefano and Poltronieri, Andrea and Haase, Peter and Kovriguina, Liubov and Meroño-Peñuela, Albert and Simperl, Elena and Staab, Steffen and Algergawy, Alsayed},
	title = {Extended NeOn-GPT: Advancing LLM-Powered Ontology Learning Through Ontology Reuse and Automated Verification},
	year = {2026},
	journal = {Semantic Web},
