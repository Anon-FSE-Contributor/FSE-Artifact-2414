	journal = {Annual International Conference of the IEEE Engineering in Medicine and Biology - Proceedings},
	volume = {7 VOLS},
	pages = {406 - 408},
	doi = {10.1109/iembs.2005.1616431},
	url = {https://www.scopus.com/pages/publications/33846919383?origin=resultslist},
	abstract = {The authors have been developing a newly-designed totally-implantable artificial myocardium using a covalent shape-memory alloy fibre (Biometal®, Toki Corporation), which is attached onto the ventricular wall and is also capable of supporting the natural ventricular contraction. This mechanical system consists of a contraction assistive device, which is made of Ti-Ni alloy. And the phenomenon of the martensitic transformation of the alloy was employed to achieve the physiologic motion of the device. The diameter of the alloy wire could be selected from 45 to 250μm. In this study, the basic characteristics of the fiber of 150μm was examined to design the sophisticated mechano-electric myocardium. The stress generated by the fiber was 400gf under the pulsatile driving condition (0.4W, 1Hz). Therefore it was indicated that the effective assistance might be achieved by using the Biometal shape-memory alloy fiber. © 2005 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 28}
