@ARTICLE{Yin2025893,
	author = {Yin, Tengxiao and Wang, Yuchen and Li, Yuhan and Liu, Mingjia and Guo, Jipeng and Wang, Youqing},
	title = {Fuzzy Inference and Temporal Logic Based Reliable Graph Neural Network for Industrial Fault Diagnosis},
	year = {2025},
	journal = {Youth Academic Annual Conference of Chinese Association of Automation, YAC},
	number = {2025},
	pages = {893 - 900},
	doi = {10.1109/YAC66630.2025.11149984},
	url = {https://www.scopus.com/pages/publications/105030923724?origin=resultslist},
	abstract = {Fault diagnosis is crucial for intelligent control in complex industrial process. In data-driven fault diagnosis filed, graph neural networks (GNNs) can model the complex topological structure and signal temporal approaches can process the time-series data, thus, reasonably combining these two methods is a popular strategy and could achieve satisfactory performance. However, the black-box modeling leads to poor interpretability and reliability in industrial system applications. To overcome this shortcoming, this paper presents a fuzzy inference and temporal logic based reliable graph neural network for industrial fault diagnosis, in which fuzzy inference is extended to GNN, i.e., FIGNN, to improve the physical interpretability of information transmission and parameterized signal temporal logic (PSTL) executes the function of temporal feature extraction. A novel model that integrates the FIGNN and PSTL layers in an alternating way to mutually enhance their capabilities. Experimental results on the Tennessee Eastman process show the performance superiority of the proposed method in industrial fault diagnosis. Meanwhile, the entire diagnosis process can be visualized by a reliable interpreter, benefiting from fuzzy inference and temporal logic.  © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Zheng2021637,
	author = {Zheng, Guolong and Nguyen, Thanhvu and Gutierrez Brida, Simon and Regis, German and Frias, Marcelo F. and Aguirre, Nazareno and Bagheri, Hamid},
	title = {FLACK: Counterexample-guided fault localization for alloy models},
	year = {2021},
	journal = {Proceedings - International Conference on Software Engineering},
	pages = {637 - 648},
	doi = {10.1109/ICSE43902.2021.00065},
	url = {https://www.scopus.com/pages/publications/85102825362?origin=resultslist},
	abstract = {Fault localization is a practical research topic that helps developers identify code locations that might cause bugs in a program. Most existing fault localization techniques are designed for imperative programs (e.g., C and Java) and rely on analyzing correct and incorrect executions of the program to identify suspicious statements. In this work, we introduce a fault localization approach for models written in a declarative language, where the models are not 'executed,' but rather converted into a logical formula and solved using backend constraint solvers. We present FLACK, a tool that takes as input an Alloy model consisting of some violated assertion and returns a ranked list of suspicious expressions contributing to the assertion violation. The key idea is to analyze the differences between counterexamples, i.e., instances of the model that do not satisfy the assertion, and instances that do satisfy the assertion to find suspicious expressions in the input model. The experimental results show that FLACK is efficient (can handle complex, real-world Alloy models with thousand lines of code within 5 seconds), accurate (can consistently rank buggy expressions in the top 1.9% of the suspicious list), and useful (can often narrow down the error to the exact location within the suspicious expressions).  © 2021 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 19}
}

@CONFERENCE{Gopinath201240,
	author = {Gopinath, Divya and Zaeem, Razieh Nokhbeh and Khurshid, Sarfraz},
	title = {Improving the effectiveness of spectra-based fault localization using specifications},
	year = {2012},
	journal = {2012 27th IEEE/ACM International Conference on Automated Software Engineering, ASE 2012 - Proceedings},
	pages = {40 - 49},
	doi = {10.1145/2351676.2351683},
	url = {https://www.scopus.com/pages/publications/84866916142?origin=resultslist},
	abstract = {Fault localization i.e., locating faulty lines of code, is a key step in removing bugs and often requires substantial manual effort. Recent years have seen many automated localization techniques, specifically using the program's passing and failing test runs, i.e., test spectra. However, the effectiveness of these approaches is sensitive to factors such as the type and number of faults, and the quality of the test-suite. This paper presents a novel technique that applies spectra-based localization in synergy with specification-based analysis to more accurately locate faults. Our insight is that unsatisfiability analysis of violated specifications, enabled by SAT technology, could be used to (1) compute unsatisfiable cores that contain likely faulty statements and (2) generate tests that help spectrabased localization. Our technique is iterative and driven by a feedback loop that enables more precise fault localization. Our framework SAT-TAR embodies our technique for Java programs, including those with multiple faults. An experimental evaluation using a suite of widely-studied data structure programs, including the ANTLR and JTopas parser applications, shows that our technique localizes faults more accurately than state-of-the-art approaches. Copyright 2012 ACM.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 30}
}

@ARTICLE{Wang2002590,
	author = {Wang, Xiaoming},
	title = {Shape memory alloy volume fraction of pre-stretched shape memory alloy wire-reinforced composites for structural damage repair},
	year = {2002},
	journal = {Smart Materials and Structures},
	volume = {11},
	number = {4},
	pages = {590 - 595},
	doi = {10.1088/0964-1726/11/4/315},
	url = {https://www.scopus.com/pages/publications/0036670362?origin=resultslist},
	abstract = {Shape memory alloy (SMA)-reinforced composite patches not only provide non-intrusive and flexible structural damage repair like normal polymer composite patches, but are also able to enhance the repair efficiency by applying active closure stress. The active closure stress is produced by shape recovery of pre-stretched SMA wires which are embedded in the composites. This paper describes the modelling of a cracked structure repaired by SMA wire-reinforced composite patches, and further evaluates the active closure stress. The issue of debonding at the interface between SMA wires and a polymer matrix is addressed to determine the maximum pre-strain that may be applied on SMA wires before they are embedded in composites. The minimum volume fraction of SMA wires required to produce the active closure stress specified in the design is then estimated, subject to a limitation no greater than 1.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 42}
}

@CONFERENCE{Shiraishi2005406,
	author = {Shiraishi, Y. and Yambe, T. and Sekine, K. and Masumoto, N. and Nagatoshi, J. and Itoh, S. and Saijo, Y. and Wang, Q. and Liu, H. and Nitta, S. and Konno, S. and Ogawa, D. and Olegario, P. and Yoshizawa, M. and Tanaka, A. and Sato, F. and Park, Y. and Uematsu, M. and Higa, M. and Hori, Y. and Fujimoto, T. and Tabayashi, K. and Sasada, H. and Umezu, M. and Homma, D.},
