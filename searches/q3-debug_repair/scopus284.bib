@ARTICLE{Li20252189,
	author = {Li, Jianping and Xiong, Wan and Zhang, Tenghang and Cheng, Hao and Shen, Kun and He, Miaojin and Zhang, Yu and Song, Junxin and Deng, Ying and Chen, Qiaowang},
	title = {Machine Learning and Explainable AI-Guided Design and Optimization of High-Entropy Alloys as Binder Phases for WC-Based Cemented Carbides},
	year = {2025},
	journal = {Computers, Materials and Continua},
