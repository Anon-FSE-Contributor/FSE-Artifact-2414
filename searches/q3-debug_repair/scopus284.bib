	author = {Yang, Shuhan and He, Dingyong and Hu, Mengze and Fan, Rui and Cui, Tianyu and Zhang, Yu and Ma, Lixia},
	title = {Electro-pulsing treatment for repairing pre-damaged Ti65 alloy: Plasticity enhancement through microstructure evolution and defect healing},
