title = {Design and Implementation of Data Acquisition System for Low Vacuum Pipeline Maglev Experimental Platform Based on Clock Synchronization},
year = {2023},
isbn = {9798400700590},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
