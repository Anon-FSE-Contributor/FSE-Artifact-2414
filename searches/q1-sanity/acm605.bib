}

@inproceedings{10.1145/609784.609814,
author = {Saunders, Norman B.},
title = {Magnetic binaries in the logical design of information handling machines},
year = {1952},
isbn = {9781450373623},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/609784.609814},
doi = {10.1145/609784.609814},
abstract = {This paper presents a brief review of the magnetic binary, its circuit functions, the facts the logician needs in laying out a machine to utilize these, and the items to be specified so that the detailed circuit design may be established.Logical designs with magnetic binaries have two possible one-to-one correspondences with designs using vacuum tubes and crystal diodes. They give the designer more latitude than is possible with the use of tubes alone. Magnetic binary detail circuit design is, however, more complicated than vacuum-tube circuit design.},
