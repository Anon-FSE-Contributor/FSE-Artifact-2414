url = {https://doi.org/10.1145/3658644.3691372},
doi = {10.1145/3658644.3691372},
abstract = {Robot vacuums have become a ubiquitous appliance, offering un- paralleled convenience and efficiency in maintaining cleanliness in both residential and commercial spaces. However, these devices also present a convenient method for attackers to gather information about the robot's surroundings. In this study, we investigate the feasibility of acoustic side-channel attacks on robot vacuums and demonstrate that sensitive information can be easily obtained by analyzing the sound produced by the robot. We extract various characteristic features and spectrograms from the sound emitted during robot movement and classify them using Multilayer Perception and Convolutional Neural Network. The evaluation results demonstrate the effectiveness of the acoustic attacks, with both machine learning models achieving more than 95% accuracy in classifying the robot's movement based on acoustic signals. Using our ML model, we demonstrate that robot cleaning path can be effectively identified with 96% accuracy. To mitigate such a threat, we perform a simulation where random noise is added to the sound samples, which effectively reduce the motion identification accuracy to 43%.},
booktitle = {Proceedings of the 2024 on ACM SIGSAC Conference on Computer and Communications Security},
pages = {5027–5029},
numpages = {3},
keywords = {machine learning, robot vacuums, side-channel attack},
location = {Salt Lake City, UT, USA},
series = {CCS '24}
}

@inproceedings{10.1145/3711129.3711311,
author = {Song, Yufan and Cao, Yupeng and Cao, Junli and Qi, Pengfei and Sun, Shuo},
title = {The Consolidation Model and Numerical Calculation for Dredged Slurry Considering the Degradation of Straw Drain body under negative pressure},
year = {2025},
isbn = {9798400710094},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3711129.3711311},
doi = {10.1145/3711129.3711311},
abstract = {In order to deal with the large amount of high water content dredging slurry produced annually in China's ports, waterways and coastal areas, an innovative dredged slurry treatment method was proposed in this paper, that is, the use of straw preparation into horizontal drainage water and vacuum precompression technology. The model test verifies the feasibility of this method. The sediment settlement calculated by the model is consistent with the measured value, although there are some differences due to vacuum fluctuation, high moisture content error and space difference. The modes of excess pore water pressure dissipation of double-layer and single-layer straw drain bodies were compared, and it was found that although the modes were different, they were symmetrical along the dredged slurry line and slightly different under the influence of dredged slurry gravity stress. When considering the self-weight stress of dredged slurry, the reinforcement effect of single-layer straw drain body is better, and the construction is simpler and the cost is lower. This study provides a new solution for the efficient and environmentally friendly treatment of dredged slurry, and is expected to contribute to the sustainable development of water conservancy and water environment treatment projects.},
booktitle = {Proceedings of the 2024 8th International Conference on Electronic Information Technology and Computer Engineering},
pages = {1070–1075},
numpages = {6},
keywords = {drainage board, dredged slurry, negative pressure consolidation, straw},
location = {
},
series = {EITCE '24}
}

@inproceedings{10.1145/3698061.3733244,
author = {Ross, Jedi and Shiveshwarkar, Priyanka and Jaworski, Justyn and Torres, Cesar},
title = {ThermAssist: Augmenting Heat Perception in Plastic Thermoforming Using Colorimetric Spray-on Diacetylene Polymer Sensors},
year = {2025},
isbn = {9798400712890},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3698061.3733244},
doi = {10.1145/3698061.3733244},
abstract = {The practice of thermoforming plastics relies on understanding the effects of temperature. Although simulations can predict these effects with precise material and equipment parameters, they often fail to communicate experiential knowledge of how different materials and processes interact. Tactile feedback and visual cues are central to determining whether a material is malleable, a skill that simulations cannot replicate. Our work explores the use of a heat-sensitive spray-on smart material made from polydiacetylene (PDA) to improve heat perception. This sensor exhibits reversible colorimetric changes in response to temperature variations from 100ºC to 200ºC, acting as a visual cue perceivable by humans. This study evaluates the sensitivity, accuracy, and practicality of PDAs in real-time temperature monitoring during vacuum forming and acrylic bending. Our findings demonstrate that PDA based sensors enhance visibility of material dispersion, provide safeguards to critical temperatures, and illustrate heat flow and conductivity, thereby improving accessibility, literacy, and relationships with materials in thermoforming practices.},
booktitle = {Proceedings of the 2025 Conference on Creativity and Cognition},
pages = {517–526},
numpages = {10},
keywords = {vacuum formation, acrylic bending, perception},
location = {
},
series = {C&amp;C '25}
}

@article{10.1145/3747355,
author = {Johnson, Jeffrey and Denning, Peter and Odlyzko, Andrew and Walker, Martin and Delic, Kemal and Yaffe, Phil and Picton, Phil},
title = {Artificial Intelligence: Foundational Technologies of Artificial Intelligence},
year = {2025},
issue_date = {July 2025},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {2025},
number = {July},
url = {https://doi.org/10.1145/3747355},
doi = {10.1145/3747355},
abstract = {More than the 70 years since its emergence in the early 1950s, artificial intelligence (AI) is performing cognitive tasks traditionally considered the unique province of humans. This progress did not occur in a vacuum. AI emerged against a rich background of technologies from computer science and ideas about intelligence and learning from philosophy, psychology, logic, game theory, and cognitive science. We sketch out the enabling technologies for AI. They include search, reasoning, neural networks, natural language processing, signal processing and computer graphics, programming and conventional software engineering, human-computer interaction, communications, and specialized hardware that provides supercomputing power. Beyond these technologies is the notion of Artificial General Intelligence that has or exceeds the capabilities of the human brain. Currently this is completely aspirational and is not expected to be possible before 2050, if ever. Artificial Intelligence is based on a variety of technologies, none of which seek to emulate human intelligence.},
journal = {Ubiquity},
month = jul,
articleno = {2},
numpages = {10}
}

@inproceedings{10.1145/3747912.3747955,
author = {Zhou, Yaoyao and Wang, Lei},
title = {Prediction of Vacuum Glass Thermal Insulation Performance via Model Agnostic Meta Learning},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747955},
doi = {10.1145/3747912.3747955},
abstract = {To overcome the scarcity and homogeneity of data in predicting the thermal transmittance (U-value) of vacuum glazing, this study proposes a Model-Agnostic Meta-Learning–based multilayer perceptron (MAML-MLP). The model shares an initial set of parameters across multiple pseudo-tasks and employs a dual inner–outer loop optimization to achieve rapid adaptation under few-shot conditions. K-means clustering partitions the original samples into clusters, each treated as a pseudo-task that is further divided into support and query sets to meet MAML's training requirements. Experimental results show that MAML-MLP significantly outperforms a conventional MLP in MAE, MSE, MAPE, and R², confirming the method's effectiveness for limited-sample engineering predictions.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {276–280},
numpages = {5},
keywords = {MAML, meta-learning, multilayer perceptron, thermal transmittance prediction, vacuum glass},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3747912.3747958,
author = {Li, Longshan and Wang, Lei},
title = {Prediction of Thermal Insulation Performance in Vacuum Glazing Using VMD-SSA-LSTM Hybrid Model},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747958},
doi = {10.1145/3747912.3747958},
abstract = {To address the challenges of nonlinearity, non-stationarity, and small sample size in predicting the thermal transmittance (U-value) of vacuum glazing, this study proposes a hybrid prediction model based on Variational Mode Decomposition (VMD), Sparrow Search Algorithm (SSA), and Long Short-Term Memory (LSTM) networks.First, Variational Mode Decomposition (VMD) adaptively decomposes the original temperature signals to extract multi-scale Intrinsic Mode Functions (IMFs), effectively suppressing noise while separating distinct heat transfer mechanism features. Second, the Sparrow Search Algorithm (SSA) globally optimizes key LSTM parameters—including hidden layer nodes, learning rate, and training epochs—to enhance the model's temporal feature extraction capability. Finally, a multi-component LSTM prediction framework is constructed, employing a weighted fusion strategy to generate high-precision prediction outputs.Experimental results show that the proposed VMD-SSA-LSTM model achieves superior performance with RMSE (0.3648), MAE (0.3429), and MAPE (1.2571%), representing 81.2%-86.3% error reduction compared to the standalone LSTM model and 38.7%-77.3% improvement over the unoptimized VMD-LSTM approach. The model attains an average prediction accuracy of 98.74% on test datasets, with errors consistently below 10% in medium-to-low value ranges. Strong linear correlation between predicted and actual values across all test cases confirms the model's robustness and exceptional predictive capability.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {294–298},
numpages = {5},
keywords = {Long Short-Term Memory, Prediction of heat transfer coefficient of vacuum glass, Sparrow Search Algorithm, Variational Mode Decomposition},
location = {
},
series = {SECA '25}
}

@inproceedings{10.1145/3638530.3654384,
author = {Fitzgerald, Seth G. and Baldwin, Sarah and Delaney, Gary W. and Howard, David and Maire, Frederic},
title = {Evolution of Material Properties and Gripping Strategy in Soft Robotic Jamming Devices},
year = {2024},
isbn = {9798400704956},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3638530.3654384},
doi = {10.1145/3638530.3654384},
abstract = {We consider the problem of design of granular materials for optimal gripping behaviour in soft robotic devices. This represents a highly challenging multi-dimensional design problem, requiring consideration of material, geometry and control strategies. Our system consists of a bag gripper composed of a flexible balloon attached to a vacuum pump, filled with granular material of non-spherical particles. At atmospheric pressure the bag is soft, flexible and deforms around a target object. When the vacuum is then applied, the granular material within the gripper densifies, freezing into a rigid shape and gripping the target object. The morphology of the particles within the granular material play a crucial role in determining the dynamics of the gripping behaviour and the overall performance of the gripper in terms of its interaction with the target object and the strength of the grip (quantified as the pull off force). In this work we consider both a real world physical gripper and a corresponding computational model (based on the Discrete Element Method), and employ NSGA-III to optimise the design of both the complex structure of the granular material within the gripper and also an optimal gripping strategy to achieve maximum gripping performance for multiple fitness criteria.},
booktitle = {Proceedings of the Genetic and Evolutionary Computation Conference Companion},
pages = {659–662},
numpages = {4},
keywords = {evolutionary robotics, granular materials, soft robotics, NSGA-III, multi-objective optimization, discrete element method, computational modelling},
location = {Melbourne, VIC, Australia},
series = {GECCO '24 Companion}
}

@inproceedings{10.1145/3747912.3747959,
author = {Hu, Guotao and Wang, Lei},
