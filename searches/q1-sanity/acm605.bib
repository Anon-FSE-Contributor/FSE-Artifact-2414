abstract = {With the development of science and technology and the improvement of economic level, human living standards and quality have significantly improved, and science has profoundly influenced people's daily lives. At the same time, with the acceleration of the pace of life, people are busy with work, do not have enough time and energy to clean their homes, and the cost of household services is also high. In response to the above issues, in this article, a microcontroller based sweeping robot is designed to serve people's daily lives, help people clean the indoor environment, reduce daily labor troubles, increase rest time, and save household service costs. The system is mainly controlled by the STC89C52 microcontroller, consisting of a vacuum module, ultrasonic obstacle avoidance module, infrared anti fall module, Bluetooth module, display module, etc. It can achieve functions such as cleaning and vacuuming, automatic obstacle avoidance, and automatic anti fall. At the same time, a mobile app is designed to connect with the robot through Bluetooth, achieving remote control of the robot.},
booktitle = {Proceedings of the 2024 3rd International Conference on Networks, Communications and Information Technology},
