abstract = {Regarding the classification problem of vacuum outgassing characteristics of nickel-based alloys in infrared focal plane packaging, the paper introduces three unsupervised learning algorithms, namely K-means, hierarchical clustering, and DBSCAN, to construct a hybrid clustering analysis model. By analyzing the outgassing characteristics data of samples under different surface roughness, blackening treatment and temperature conditions, the superiority of the K-means algorithm in terms of clustering quality and process compatibility was verified. The clustering results effectively identified three types of typical outgassing patterns, revealed the intrinsic relationship between process parameters and outgassing characteristics, and provided data support and theoretical basis for the process optimization of electroforming cold screen materials.},
booktitle = {Proceedings of the 2025 2nd Symposium on Big Data, Neural Networks, and Deep Learning},
pages = {180–185},
