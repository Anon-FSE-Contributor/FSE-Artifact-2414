year = {2024},
isbn = {9798400716485},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3653081.3653167},
doi = {10.1145/3653081.3653167},
abstract = {This paper introduces an intelligent drilling system for urban rail transit projects. The drilling system mainly consists of an actuator, a robot mechanism, a vacuum system, a travel mechanism, a hydraulic system, an intelligent control system and a power system. The drilling system uses a robot mechanism as the core, combined with vision recognition technology, to automatically perform drilling operations. The drilling system adopts the form of double drill instead of manual drilling, which improves the efficiency of the construction. The developed equipment has improved the overall construction quality of the project works, saved the project cost, and also solved the problem of safety hazards brought by traditional construction methods.},
booktitle = {Proceedings of the 2023 5th International Conference on Internet of Things, Automation and Artificial Intelligence},
pages = {516–521},
numpages = {6},
