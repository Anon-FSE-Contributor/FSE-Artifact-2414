address = {New York, NY, USA},
url = {https://doi.org/10.1145/3778534.3778595},
doi = {10.1145/3778534.3778595},
abstract = {With the aerospace industry increasingly emphasizing lightweight and precision manufacturing, there is a growing demand for casting technologies pertaining to critical components. Evaluating the developmental potential of casting equipment and understanding the international competitive landscape, along with identifying emerging technology hotspots and breakthrough opportunities, is essential for enhancing the core competitiveness of China's aerospace manufacturing sector and overcoming existing technological barriers. In recent years, there has been a conspicuous lack of systematic analysis regarding the current status, trends, and competitive dynamics of advanced casting equipment for hot-end components in aircraft engines within China. This paper utilizes the "PatSnap" global patent database and employs a patent analysis methodology to investigate the research and technological development trends related to hot-end component casting equipment, as well as the distribution of countries and institutions, technological competition, and emerging technological hotspots. The analysis reveals that academic research and technological advancements in hot-end component casting equipment are currently in a phase of rapid growth, presenting broader development prospects in line with the accelerated progression of the aerospace industry. Recent technological development trends such as vacuum melting, single crystal casting, and directional solidification have shown significant potential. While China currently stands as a technological leader in this field, there remains a gap in patent quality, with the United States and Japan emerging as formidable competitors.},
booktitle = {Proceedings of the 4th International Conference on Artificial Intelligence and Intelligent Information Processing},
pages = {387–397},
numpages = {11},
keywords = {Casting, High-Temperature Alloys, Hot-End Components, Patent Analysis},
location = {
},
series = {AIIIP '25}
}

