@inproceedings{10.1145/3733054.3733082,
author = {Zhu, Jiazheng and Liang, Xiao and Xu, Jiannan and Zhang, Yingqiang and Zhang, Zhonghao and He, Kejia},
title = {Power Knowledge Question-Answering System Based on Agents, Chain-of-Thought and In-Context Learning},
year = {2025},
isbn = {9798400715198},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3733054.3733082},
doi = {10.1145/3733054.3733082},
abstract = {Electric power industry is very important to our modern life. The traditional knowledge and question-answering can not adapt to the increasingly complex huge data with the development of power system. Although the LLMs succeed in common cases, they can hardly understand and answer questions from the power industries successfully. How to effectively solve some hard problems, such as comprehensively apply the knowledge base of the power industry domain, improve the multi-jump and complicated QA capability, avoid refine tuning of the large models and so on has never been reported before. To fill the research vacuum points above mentioned, this paper has explored a way to construct CoT dataset, design an ICL technique in-context learning and generate the agent framework for electricity-related QA task respectively. Experiments show that: Compared with other ways, using Agent + CoT + ICL methods makes our model perform better in accuracy and solving skills; it verifies the effectiveness of the method designed here.},
booktitle = {Proceedings of the 2025 International Conference on Intelligent Systems, Automation and Control},
pages = {153–158},
numpages = {6},
keywords = {Agent framework, Chain-of-Thought, In-Context Learning, Large language models, Power knowledge question-answering},
location = {
},
series = {ISAC '25}
}

@inproceedings{3721488.3721492,
author = {Strengers, Yolande},
title = {Creating Sustainable Life Worlds with Robots},
year = {2025},
publisher = {IEEE Press},
abstract = {Robots are rapidly changing how we live and think about our future everyday lives. However, questions of sustainability rarely engage with the kinds of worlds successful robots enable and help to bring about. The potential to imagine more sustainable worlds for people, robots and other non-humans to inhabit is vast and largely untapped. In this talk I will demonstrate how the dominate ways we think about environmental sustainability and social inclusion in robotics is limiting the potential for more sustainable outcomes by narrowing the focus on inputs, outputs and causal relationships. I will showcase several projects informed by sociological and anthropologic research with Australian households and international colleagues that open up new possibilities for more sustainable everyday life. Focusing on the smart home and domestic robots-such as robotic vacuum cleaners and digital voice assistants-I will demonstrate how intentions for resource efficiency and sustainability are commonly subsumed by more resource intensive lifestyle visions that may lead to perverse outcomes. Drawing on these projects and their design ethnography methodologies, I will provide examples of other ways of researching and thinking with the future lifestyle visions associated with smart homes and robots to help realize alternative and more sustainable life worlds. These include exploring new aesthetic imaginaries for the environments where robots are intended to become (or already are) ubiquitous; paying attention to the practices in which robots are likely to become embedded; and designing research methods which enable current or potential household users to imagine alternative future relationships with robots.},
booktitle = {Proceedings of the 2025 ACM/IEEE International Conference on Human-Robot Interaction},
pages = {3},
numpages = {1},
keywords = {design ethnography, everyday life, human-robot interaction},
location = {Melbourne, Australia},
series = {HRI '25}
}

