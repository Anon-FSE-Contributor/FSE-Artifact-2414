@inproceedings{10.1145/3696500.3696590,
author = {Sun, Mingwei and Wu, Jinjun and Wang, Ying and Li, Jingying},
title = {Research on Frontier and Hotspot Technologies in Vacuum/Isothermal Forging Based on Patent Analysis},
year = {2024},
isbn = {9798400710278},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3696500.3696590},
doi = {10.1145/3696500.3696590},
abstract = {Foundation manufacturing is the cornerstone of the equipment manufacturing industry. Assessing the development potential and international competitive landscape of foundation manufacturing, identifying technological frontiers, and recognizing breakthrough opportunities are crucial for enhancing China's manufacturing core competitiveness and breaking through technological barriers. Despite efforts to strengthen industrial foundation reconstruction and major technological equipment development in recent years, there lacks a systematic analysis of the current status, development trends, and technological competition situation of segmented foundation manufacturing technology and equipment. This paper relies on the “PatSnap” global patent database and adopts a patent analysis method to conduct a comprehensive and in-depth study on vacuum/hot isothermal forging. By reviewing the academic research, technological development trends, national and institutional distribution, technological competition, and technological frontiers related to vacuum/hot isothermal forging, this research provides valuable insights. Regular updates and analyses of the data enable dynamic tracking of technological advancements. The study reveals that academic research and technological development in vacuum/hot isothermal forging are currently experiencing rapid growth, with applications extending from traditional manufacturing processing industries to strategic emerging industries such as aerospace, electronic information, and new materials. Numerical simulation technology, highly resistant materials, multi-field coupling technology, and high-temperature forging dies are identified as having development potential and emerging as technological trends. China is currently a technological leader, enjoying a first-mover advantage, while Japan and the United States are formidable followers in the field.},
booktitle = {Proceedings of the 2024 International Conference on Big Data and Digital Management},
pages = {543–555},
numpages = {13},
location = {Shanghai, China},
series = {ICBDDM '24}
}

