@inproceedings{10.1145/3820253.3820259,
author = {Konopka, Bj{\"o}rn and Wiesche, Manuel},
title = {Facilitating Informed Privacy Decisions in Smart Homes: Design Principles for Contextualized Data Permission Justifications},
year = {2026},
isbn = {9798400726118},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820253.3820259},
doi = {10.1145/3820253.3820259},
abstract = {Data permission justifications often fail to enable informed privacy decisions, especially in smart homes where “always-on” devices and opaque sensor mappings leave users unable to assess data flow legitimacy. To address this gap, we employ a Design Science Research (DSR) approach to develop user-centric, contextualized data permissions. Drawing on Contextual Integrity Theory (CIT) and the Elaboration Likelihood Model (ELM) as kernel theories, we derive six meta-requirements and three design principles. We instantiate these design principles in a software artifact simulating the data permission setup process of a robot vacuum cleaner and evaluate our prototype by conducting a between-subjects online experiment (N = 179). Our results demonstrate that contextualized justifications significantly influence user understanding and the perception of benefits and yield a strong behavioral shift toward rejecting overreaching data permissions. This research contributes design knowledge to enable researchers and practitioners to develop more usable data permission systems for smart home environments.},
booktitle = {Proceedings of Mensch Und Computer 2026},
pages = {157–173},
numpages = {17},
keywords = {Contextual Integrity, Data Permissions, Design Science Research, Elaboration Likelihood Model, Smart Home, Usable Privacy},
location = {
},
series = {MuC '26}
}

@inproceedings{10.1145/3816440.3818579,
author = {Mugdho, Sohan Salahuddin and Hasan, Md Shahedul and Wang, Cheng},
title = {Space-CIM: Enabling Compute-In-Memory Accelerators for Thermally-Constrained Space Platforms},
year = {2026},
isbn = {9798400727481},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3816440.3818579},
doi = {10.1145/3816440.3818579},
abstract = {The rapid growth in compute demand from artificial intelligence (AI) has driven a massive surge in data center construction, precipitating an energy and sustainability crisis. Motivated by the abundant solar energy in outer space and the recent sharp reduction in space launch costs, orbital data centers are emerging as a potential pathway for the future scaling of AI compute infrastructure. While the cold background in vacuum seems appealing for cooling, computing systems operating in space without convection ultimately rely on radiative cooling, requiring large-area radiators. Such limitations in thermal management pose a significant challenge for deploying the standard liquid/air-cooled computers in space. In this work, we investigate the impact of the thermal constraints in space on both graphics processing units (GPUs) with high-bandwidth memory (HBM) and the emerging compute-in-memory (CIM) accelerators. We develop a radiator-in-the-loop co-design methodology that directly links the permitted system TOPS (terra-operations per second) with the practical radiator cooling capacity in space. Our thermal simulations reveal that the separately located GPU die and HBMs create severe thermal hotspots under limited radiator capacity, necessitating GPU thermal throttling. In contrast, CIM accelerators exhibit a much more uniform heat distribution and consistently outperform GPUs in TOPS/W across a wide range of radiator budgets. We systematically evaluated the performance of CIM and GPU across various AI workloads and demonstrated that CIM has a magnified advantage for deployment in space under realistic thermal constraints.},
booktitle = {Proceedings of the ACM/IEEE International Symposium on Low Power Electronics and Design},
articleno = {35},
numpages = {7},
keywords = {AI Accelerators, Compute-In-Memory, Radiative Cooling, Space Computing, Thermal Throttling},
location = {
},
series = {ISLPED '26}
}

@inproceedings{10.1145/3803437.3805552,
author = {Ran, Huaijin and Zhang, Haoyi and Kim, Kisub and Tang, Xunzhu},
title = {Who Wrote This Patch? Toward Accountable Automated Program Repair},
year = {2026},
isbn = {9798400726361},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3803437.3805552},
doi = {10.1145/3803437.3805552},
abstract = {Automated Program Repair (APR) has evolved from academic curiosity to industrial necessity. Large Language Model-based repair tools now generate patches at unprecedented scale, yet this deployment creates an accountability vacuum: when AI-generated patches fail, who bears responsibility? Current APR systems lack mechanisms to verify patch provenance—a critical gap as regulations demand transparency and organizations struggle with liability attribution. We propose that watermarking may offer a path toward accountable repair, but APR imposes unique constraints: patches must be correct, minimal, and natural. These constraints render existing watermarking insufficient. We propose multi-patch fingerprinting, distributing provenance across repair portfolios rather than individual patches through behavioral signatures and opportunistic embedding. This paper articulates why traceable APR matters, examines tensions between repair constraints and watermarking, and outlines a research agenda toward accountable repair ecosystems.},
booktitle = {Proceedings of the 34th ACM International Conference on the Foundations of Software Engineering},
pages = {1182–1186},
numpages = {5},
keywords = {automated program repair, watermarking, code provenance, accountability, fingerprinting},
location = {Concordia University, Montreal, QC, Canada},
series = {FSE Companion '26}
}

@inbook{10.1145/3805689.3812282,
author = {Maeda, Takuya and Buening, Rebecca},
title = {Safety Theater in Anthropomorphic AI: Why We Need to Shift from Safety to Accountability Narratives},
year = {2026},
isbn = {9798400725968},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3805689.3812282},
abstract = {Despite decades of research on anthropomorphic AI's unique ability to create relational (interaction) harms, few legitimately effective interventions exist. Taking this as an epistemic problem, this paper explores the limitations of the “AI safety” narrative that dominates “responsible AI” discourse—a narrative that frames interaction harms as malfunctions/user errors and harm mitigation as technical optimization/disclosure. We compare this to “AI accountability” narratives that frame interaction harms as structural issues and mitigation as external regulatory oversight. Adopting an accountability narrative to chart the sociotechnical and political economic dimensions of anthropomorphic AI, we reveal what a safety narrative conceals: that anthropomorphic features are both social cues that instigate parasocial dynamics and engagement capture mechanisms that enable companies to extract more value from interactions. In this view, interaction harms are not discrete malfunctions but processual intensifications of target use cases that compound with increasing attachment (what we call “harm creep”). Because safety mitigation efforts reinforce “value-aligned” personality design, which in turn supports parasocial attachment, we suggest that safety interventions may reinforce interaction harms rather than mitigating them while externalizing responsibility to users (a context collapse condition we describe as “safety theater,” which perpetuates the existing accountability vacuum). A more appropriate solution would involve safety interventions that account for harm creep and accountability interventions that constrain extraction incentives through external monitoring and power redistribution.},
booktitle = {Proceedings of the 2026 ACM Conference on Fairness, Accountability, and Transparency},
pages = {2225–2252},
numpages = {28}
}

@inproceedings{10.1145/3776942.3777004,
author = {Zheng, Linjie and Hu, Yilin and Shen, Xue and Sun, Yilu and Chen, Guohui and Ye, Qin and Chen, Zhen},
title = {Research on Optimization of ZB48 Packaging Machine's Automatic Feeding of Trademark Paper without Manual Intervention Based on Multi-System Collaboration},
year = {2025},
isbn = {9798400715839},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3776942.3777004},
doi = {10.1145/3776942.3777004},
abstract = {The in-depth application of the concept of intelligent manufacturing in the tobacco manufacturing industry has put forward higher requirements for the continuity and automation level of high-speed packaging equipment. The automatic feeding system for trademark paper, as a key auxiliary material supply link of the high-speed packaging machine (ZB48 type), its degree of intelligence directly affects the overall efficiency of the equipment. Aiming at the problems existing in the current system, such as the reliance on manual intervention during the vacuum period of auxiliary material supply, the speed mismatch between conveyor belts and packaging machines, and the insufficient coordination of AGV logistics, this study proposes an optimization method based on millisecond-level coordination and intelligent decision-making of multiple systems. Firstly, the influence mechanism of the variation of the stacking interval of trademark paper on the conveying stability and the causes of the dependence on manual intervention were analyzed; Secondly, an innovative software transformation scheme for the single-section belt based on the dynamic spacing compensation algorithm was designed, achieving real-time coordination between the conveyor belt speed and the operating status of the packaging machine. Secondly, an auxiliary material caching system based on idle transport capacity scheduling was constructed. By adopting the first-in, first-out strategy and precise handling by robotic arms, the problem of auxiliary material supply during the vacuum period of pallet replacement was solved. Finally, an intelligent pallet transfer system for auxiliary material stations integrated with laser feature recognition was developed, achieving safe access and efficient collaboration for AGV carts, and significantly enhancing the automation, informatization and intelligence levels of high-speed packaging lines.},
booktitle = {Proceedings of the 2025 11th Annual International Conference on Network and Information Systems for Computers},
pages = {197–202},
numpages = {6},
keywords = {Automatic feeding for trademark paper, Multi-system collaboration Auxiliary material cache AGV intelligent transfer High-speed packaging machine, No human intervention},
location = {
},
series = {ICNISC '25}
}

@inproceedings{10.1145/3802514.3809179,
author = {Tarte, Isha and Jayaraman, Jayadeep and Modi, Abhishek and Karve, Vishal and Lu, Jingwei and Badhya, Sourabh and Sarkar, Rajarshi and Shah, Aditya and Mangla, Haymant and Cao, Zihan and Liu, Huadong and Zhu, Warren and Yan, Wei},
title = {Table Format Optimizations in Managed Spark for Dataproc},
year = {2026},
isbn = {9798400726354},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3802514.3809179},
doi = {10.1145/3802514.3809179},
abstract = {Efficient data lifecycle management is critical for modern Lake-House architectures, yet standard open source implementations of transactional updates and storage maintenance often suffer from prohibitive I/O and compute costs. This paper presents novel, format-aware optimizations implemented within the Dataproc Spark engine, including workload aware optimizations. For transactional workloads on Lakehouse, we introduce Precision Merge, which utilizes a row-level tracking mechanism to minimize shuffle and wasted compute. Furthermore, we propose significant enhancements to table maintenance operations, utilizing Direct Binary Merge for efficient compaction and a multi-tiered, asynchronous framework for VACUUM processes. Extensive benchmarking demonstrates that these combined strategies deliver over a 50% reduction in execution time, a 10x decrease in shuffle volume, and up to a 10x speedup in routine maintenance, providing a highly scalable and cost-effective solution for high-throughput Lakehouse management.},
booktitle = {Proceedings of the 1st International Workshop on Data FORMATS for Modern Architectures and Workloads},
articleno = {6},
numpages = {4},
keywords = {Lakehouse Architectures, Apache Spark, Apache Iceberg, Delta Lake, Data Lifecycle Management, Table Maintenance},
