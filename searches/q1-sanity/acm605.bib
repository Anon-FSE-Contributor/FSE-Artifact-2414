}

@inproceedings{10.1145/1321631.1321687,
author = {Lauenroth, Kim and Pohl, Klaus},
title = {Towards automated consistency checks of product line requirements specifications},
year = {2007},
isbn = {9781595938824},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/1321631.1321687},
doi = {10.1145/1321631.1321687},
abstract = {A requirements specification for an individual software system should be consistent, i.e. free of contradictions. In product line engineering, the product line requirements specification comprises all the requirements common to all products of the product line as well as the variable requirements used to derive individual products from the product line. The set of requirements (common and all the variable ones) of a product line is typically inconsistent since variable requirements can contradict each other. This is not a problem as long as contradicting requirements are not included in a product derived from the product line. Thus, the set of requirements realized in each individual product has to be consistent. Employing techniques used in single system development to check the consistency of product line requirements will thus produce false positive results, since there can be contradiction in the product line requirements specificationIn this paper we first provide a concise definition of consistency for product line requirements specifications. Based on this definition, we define a formal framework for checking consistency of product line requirements specifications. Our framework supports consistency checks in the domain engineering process. In contrast to consistency checks in single system development, it tolerates certain types of inconsistencies caused by the variability of prod-uct line requirements.},
booktitle = {Proceedings of the 22nd IEEE/ACM International Conference on Automated Software Engineering},
pages = {373–376},
numpages = {4},
keywords = {consistency, product line, requirements engineering},
location = {Atlanta, Georgia, USA},
series = {ASE '07}
}

@inproceedings{10.1145/3742875.3754688,
author = {Yu, Sheng-Jung and Sangiovanni-Vincentelli, Alberto},
title = {Ensuring Strong Replaceability of Assume-guarantee Contract for Feedback Composition},
year = {2026},
isbn = {9798400719943},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3742875.3754688},
doi = {10.1145/3742875.3754688},
abstract = {Contract-based design is a promising design methodology that leverages rigorous specification, refinement relation, and composition operation for compositional reasoning to address system design complexity and heterogeneity by facilitating independent development of the subsystems. However, vacuous implementations—those with empty behaviors under the targeted environment—can occur even if the subsystem designers correctly refine the contracts according to the refinement relation. This compromises the benefits of independent development as vacuous implementations fail to satisfy the design goals. Although previous research emphasizes the importance of strong replaceability and receptiveness in addressing this issue, strong replaceability in feedback composition is not guaranteed. In this paper, we tackle this challenge by identifying conditions to ensure strong replaceability in feedback composition. These conditions are developed and validated through the analysis of fixed obligations, representing the behaviors collaboratively allowed by subsystem contracts, and fixed obligation graphs, which illustrate the relation between fixed obligations. We propose algorithms to verify strong replaceability for the subsystem contracts, offering a general approach that utilizes set operations and satisfiability modulo theories-based encoding to circumvent reliance on specific underlying theories in contract descriptions. By addressing this gap in contract-based design methodology, our developed conditions and algorithms ensure correct and meaningful implementations.},
booktitle = {Proceedings of the International Symposium on Formal Methods and Models for System Design},
pages = {47–56},
numpages = {10},
location = {Taipei International Convention Center (TICC), Taipei, Taiwan},
series = {MEMOCODE '25}
}

@article{10.1145/3828556,
author = {Agarwal, Ritu and Padmanabhan, Balaji and Liu, Yizhi},
title = {Surfacing the Invisible: AI and the IS Discipline},
year = {2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
issn = {2158-656X},
url = {https://doi.org/10.1145/3828556},
doi = {10.1145/3828556},
abstract = {The current debate about Artificial Intelligence (AI) in scientific research concerns problems that appear in the published record – fabricated citations, AI-generated submissions, the strain on peer review, vacuous prose devoid of substance. These problems are real and measurable, but they represent only the tip of a far deeper iceberg. Beneath them lie effects that produce no signal the system is trained to detect: activities that did not take place, capacities that were not built, guarantees that no longer hold. This commentary surfaces these invisible costs for the information systems discipline. When doctoral students outsource the difficult work of writing, reading, and deriving to AI, the apprenticeship mechanism through which scholarly expertise has always been formed is quietly dismantled. When AI-mediated literature workflows replace deep engagement with targeted retrieval, the cross-domain encounters that have historically generated the field's most consequential research questions are lost. And when the activities that build evaluative judgment disappear, the disciplinary commons on which editors, reviewers, and tenure committees depend is eroded. Two further dynamics compound the problem: empirical evidence increasingly rests on commercial models that cannot be re-inspected or reproduced, and publication counts have been decoupled from the cognitive engagement they once represented. The harder question, and the one current evaluation mechanisms are not equipped to answer, is how a scientific community detects what is no longer being attempted. The IS discipline must move deliberately and intentionally toward revaluing what AI makes scarce rather than what it makes abundant. We offer concrete suggestions for a path forward here.},
note = {Just Accepted},
journal = {ACM Trans. Manage. Inf. Syst.},
month = jul,
keywords = {Computing methodologies → Artificial intelligence, • Social and professional topics → Computing education, Computing profession, artificial intelligence, information systems, knowledge production, scientific inquiry, scholarly evaluation, It's the writing that teaches you. – Isaac Asimov, Any sufficiently advanced technology is indistinguishable from magic. – Arthur C. Clarke}
}

