@inbook{10.1145/3821966.3822005,
author = {Zhou, Xuewei},
title = {Artificial Intelligence-Enhanced Fault Tree Analysis: A Review of Methodologies, Applications, and Future Directions in Aerospace Safety Engineering},
year = {2026},
isbn = {9798400721939},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3821966.3822005},
abstract = {Fault Tree Analysis (FTA) remains the foundational deductive methodology in safety engineering, particularly for critical and irreversible scenarios like spacecraft thermal vacuum testing. However, as aerospace architectures become highly coupled and software-intensive, traditional FTA methods expose critical bottlenecks. They rely on labor-intensive manual construction, static Boolean logic that fails to capture real-time operational shifts, and subjective expert heuristics, ultimately struggling to meet the dynamic safety requirements of modern missions. This paper provides a critical analytical review of AI integration with FTA, focusing on three primary dimensions: automated construction, intelligent diagnosis, and dynamic risk quantification. Specifically, we evaluate how Large Language Models (LLMs) parse engineering corpora while addressing domain hallucination risks, how multimodal networks fuse heterogeneous data for anomaly detection, and how deep learning enables dynamic probability estimation within deterministic frameworks. By synthesizing these advancements, this review highlights the transition toward physics-informed and human-in-the-loop paradigms, offering a structured roadmap to bridge algorithmic agility with the uncompromising reliability and certification standards required for aerospace safety systems.},
booktitle = {Proceedings of the 2026 3rd International Conference on Innovation Management and Information Systems},
pages = {231–236},
numpages = {6}
}

