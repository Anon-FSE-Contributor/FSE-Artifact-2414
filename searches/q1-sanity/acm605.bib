@inproceedings{3712729.3712857,
author = {Wuttke, Alexander and Rabe, Markus and Hunker, Joachim and Diepenbrock, Jan-Philipp},
title = {Combining Simulation and Recurrent Neural Networks for Model-Based Condition Monitoring of Machines},
year = {2025},
isbn = {9798331534202},
publisher = {IEEE Press},
abstract = {Maintenance is pivotal in industry, with condition-based maintenance emerging as a key strategy. This involves monitoring the machine condition through sensor data analysis. Model-based approaches compare observed data with expected values from models, which requires high-quality models. An established method is to use simulation models, which in many cases produce good results but may lack precision due to uncertainties. Alternatively, models created by machine learning can detect patterns directly from data. This paper proposes combining simulation models with machine learning models, leveraging the simulation's a-priori knowledge and machine learning's data patterns to enhance models for condition monitoring. Recurrent neural networks are suggested as the machine learning method. The paper outlines a systematic approach and demonstrates its application in an industrial use case, which investigates vacuum processes in industrial furnaces.},
booktitle = {Proceedings of the Winter Simulation Conference},
pages = {1551–1562},
numpages = {12},
location = {Orlando, Florida, USA},
series = {WSC '24}
}

@inproceedings{10.1145/3724504.3724512,
author = {Lei, Bin and Zhang, Zixuan and Chen, Minghui and Li, Junhao and Deng, Yukun and Chen, Shurong and Zhang, Hui and Su, Jiang},
title = {Design and Implementation of Intelligent Production Line Equipment for Mechanical and Electrical Training Teaching Based on Vacuum Adsorption Technology},
year = {2025},
isbn = {9798400711732},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3724504.3724512},
doi = {10.1145/3724504.3724512},
abstract = {In response to the problems of insufficient training resources, adjustable training equipment, and disconnection between training content and teaching content in the current electromechanical professional training and teaching equipment, this article designs a mechatronics integrated training and teaching production line equipment based on vacuum adsorption technology. This equipment is based on motor motion control technology, combined with practical work scenarios and practical teaching content design. Four sets of practical teaching modules have been designed, corresponding to the technical skills of three-phase asynchronous motors, DC motors, stepper motors, and servo motors. By designing a semi open electrical control module, students can personally participate in the electrical assembly and debugging process of the equipment modules. The production line equipment adopts an integrated Siemens PLC as the core controller, various motors as execution components, and combines digital twin technology to design an automatic production line equipment for electromechanical training and teaching. Through this device, students can gain a deeper understanding of the application scenarios and motion control methods of four types of motors, effectively improving the practical teaching effectiveness of the teaching equipment.},
booktitle = {Proceedings of the 2024 2nd International Conference on Information Education and Artificial Intelligence},
pages = {40–50},
numpages = {11},
keywords = {Digital twin, PLC, Training equipment, Vacuum adsorption, electric machinery},
location = {
},
series = {ICIEAI '24}
}

@inproceedings{10.1145/3703323.3704282,
author = {Singhal, Pulkit and Tauro, Sheldon},
title = {File formats for Analytical systems},
year = {2025},
isbn = {9798400711244},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3703323.3704282},
doi = {10.1145/3703323.3704282},
abstract = {As organizations increasingly adopt data-driven approaches, the demand for analyzing and processing massive datasets continues to rise. While traditional SQL-based systems are often used for transactional workloads, they face significant limitations when addressing analytical workloads. Analytical queries require optimizing for large-scale data traversal, complex aggregations, and ensuring performance over diverse data arrangements. This tutorial explores the evolution of file formats and storage solutions designed specifically for Online Analytical Processing (OLAP) systems. We will address the limitations of traditional solutions, such as SQL servers and Hive table formats, and introduce modern approaches, starting with Parquet. Key challenges, including the need for efficient metadata management, pruning, and transaction semantics, are discussed, paving the way for solutions like Delta Lake and Apache Iceberg. We will dive into how these storage solutions addresses critical challenges such as small file problems, schema evolution, and the need for transactional integrity in cloud storage. Advanced topics include Z-ordering[15], data skipping, materialized aggregates, ZoneMaps, Bloom filters[11], deletion vectors[8], and liquid clustering. We will also explore solutions for space management (e.g., vacuuming) and multi-table transactions.},
booktitle = {Proceedings of the 8th International Conference on Data Science and Management of Data (12th ACM IKDD CODS and 30th COMAD)},
pages = {366–368},
numpages = {3},
keywords = {analytical systems, file formats, delta lake, iceberg, hudi},
location = {
},
series = {CODS-COMAD '24}
}

@inproceedings{10.1145/3653081.3653210,
author = {Pan, Shangjie and An, Wanqing and Zhang, Yu and Zou, Shijie and Zhang, Yuchang},
title = {Design and application of automatic measurement and control system for thermal vacuum test of spacecraft components},
year = {2024},
isbn = {9798400716485},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3653081.3653210},
doi = {10.1145/3653081.3653210},
abstract = {In this paper, an automatic measurement and control system is designed and developed for thermal vacuum test of spacecraft components. The system is built based on industrial Ethernet, with distributed measurement and control computer and unified data server as the main body to carry out test business data processing and storage, temperature data acquisition and PID closed-loop control by driving program control power supply, data acquisition instruments and other equipment, the system has strong scalability, high stability, high control accuracy, and short acquisition and control cycle. Through automatic control strategy and abnormal alarm mechanism, the system improves the ability of automatic measurement and control and abnormal handling, reduces the labor intensity of test personnel, and improves the quality control level of test process. Hundreds of thermal vacuum tests of spacecraft components have been completed by using this system, which has high application value.},
booktitle = {Proceedings of the 2023 5th International Conference on Internet of Things, Automation and Artificial Intelligence},
pages = {769–774},
numpages = {6},
location = {Nanchang, China},
