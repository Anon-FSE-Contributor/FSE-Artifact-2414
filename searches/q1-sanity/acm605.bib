pages = {977–983},
numpages = {7},
location = {Anaheim, California},
series = {AFIPS '72 (Fall, part II)}
}

@inproceedings{10.1145/1478873.1479012,
author = {Stenberg, Warren},
title = {Computing in the high school---past, present and future: and its unreasonable effectiveness in the teaching of mathematics},
