	title = {Consistency checking of specification in UML},
	year = {2017},
	journal = {Computer Systems and Software Engineering: Concepts, Methodologies, Tools, and Applications},
	pages = {993 - 1010},
	doi = {10.4018/978-1-5225-3923-0.ch039},
	url = {https://www.scopus.com/pages/publications/85041613426?origin=resultslist},
	abstract = {The increasing use of software is giving rise to the development of highly complex software systems. Further, software systems are required to be of high quality as a defect can have catastrophic effect on business as well as human life. Testing is defined as the process of executing a program with the intention of finding errors. Software testing is an expensive process of the software development life cycle consuming nearly 50% of development cost. Software testing aims not only to guarantee consistency in software specification but also to validate its implementation meeting user requirements. On the whole, it is observed that in general, errors in software systems set in at the early stages of the software development cycle (i.e. while gathering user requirements and deciding on specification of intended software). Even though formal specification in B and Z assures a provable system, its use has become less popular due to mathematical rigor. The Unified Modeling Language (UML), a semi-formal language with graphical notations consisting of various diagrams has caught software developers’ imaginations and, it has become popular in industry. UML, with its several diagrams, helps to develop a model of intended software, and the model behaviour is simulated and tested to the satisfaction of both developer as well as users. As a UML model includes specifications of different aspects of a software system through several diagrams, it is essential to maintain consistency among diagrams so that quality of the model is maintained, and through inconsistency checking and removal, the model moves toward completeness. The works reported in literature on this topic are reviewed here. © 2018 by IGI Global. All rights reserved.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Lingam20263455,
	author = {Lingam, Keerthi and Chittineni, Suresh},
	title = {SIBO: A Multimodal Corpus of South Indian Bail Orders for Fairness-Aware Judicial Analysis},
	year = {2026},
	journal = {IAENG International Journal of Computer Science},
	volume = {53},
	number = {9},
	pages = {3455 - 3474},
	url = {https://www.scopus.com/pages/publications/105049039535?origin=resultslist},
	abstract = {The Indian judiciary faces a backlog of over 35.6 million pending criminal cases. More than four lakh undertrials remain in prisons awaiting their hearings. Bail delays are a major reason. Automated decision-support systems can accelerate case resolution but risk perpetuating gender and religion biases embedded in historical legal records. Building fair AI-support tools for the legal system requires structured, high-quality corpora that capture the complexity of real judicial proceedings. Yet no such resource exists for South Indian courts. We present SIBO, the South Indian Bail Orders corpus, a bail-specific multimodal legal corpus for South India. SIBO comprises 21,881 bail petition records collected from publicly available eCourts records across the district courts in Andhra Pradesh. SIBO integrates three complementary data sources. These are structured case metadata, extracted legal entities with demographics, and unstructured textual summaries. We extracted entities and summaries using GPT-3.5 Turbo and validated them against expert annotations, achieving Cohen's κ up to 0.89 for demographic classification and ROUGE-1 F1 of 0.51–0.59 for legal argument summarization. An observational analysis of bail outcomes reveals small but statistically significant associations with petitioner gender and religion, consistent with prior work on Indian courts. We then benchmarked ten models on SIBO, spanning classical baselines, multimodal architectures, and a fine-tuned language model. A late-fusion of fine-tuned RoBERTa with XGBoost achieves accuracy 0.92, F1 0.91, and AUC-ROC 0.96, with Demographic Parity Difference below 0.05 across gender and religion, without any fairness-aware training. We confirm the robustness of these results through five reproducibility diagnostics, including a shuffled-label sanity check (AUC 0.503) and 5-fold cross-validation (accuracy 0.959 ± 0.003). © 2026, International Association of Engineers. All rights reserved.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Tarique2026179,
	author = {Tarique, Saima and Fatma, Mahwish and Jahan, Rehmat and Fatma, Tahsin and Ahmad, Shabbir and Sadiq, Mohd.},
	title = {Eliciting the Ranking Order of Functional Requirements of Software Using Fuzzy TOPSIS Without Conflictions Among Non-Functional Requirements},
