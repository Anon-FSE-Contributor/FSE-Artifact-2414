@CONFERENCE{Camburu20204157,
	author = {Camburu, Oana-Maria and Shillingford, Brendan and Minervini, Pasquale and Lukasiewicz, Thomas and Blunsom, Phil},
	title = {Make up your mind! adversarial generation of inconsistent natural language explanations},
	year = {2020},
	journal = {Proceedings of the Annual Meeting of the Association for Computational Linguistics},
	pages = {4157 - 4165},
	url = {https://www.scopus.com/pages/publications/85117902872?origin=resultslist},
	abstract = {To increase trust in artificial intelligence systems, a promising research direction consists of designing neural models capable of generating natural language explanations for their predictions. In this work, we show that such models are nonetheless prone to generating mutually inconsistent explanations, such as “Because there is a dog in the image.” and “Because there is no dog in the [same] image.”, exposing flaws in either the decision-making process of the model or in the generation of the explanations. We introduce a simple yet effective adversarial framework for sanity checking models against the generation of inconsistent natural language explanations. Moreover, as part of the framework, we address the problem of adversarial attacks with full target sequences, a scenario that was not previously addressed in sequence-to-sequence attacks. Finally, we apply our framework on a state-of-the-art neural natural language inference model that provides natural language explanations for its predictions. Our framework shows that this model is capable of generating a significant number of inconsistent explanations. © 2020 Association for Computational Linguistics},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 60}
}

@ARTICLE{Ito20222801,
	author = {Ito, Sohei and Osari, Kenji and Shimakawa, Masaya and Hagihara, Shigeki and Yonezaki, Naoki},
	title = {Efficient Realizability Checking by Modularization of LTL Specifications},
	year = {2022},
	journal = {Computer Journal},
	volume = {65},
	number = {10},
	pages = {2801 - 2814},
	doi = {10.1093/comjnl/bxab116},
	url = {https://www.scopus.com/pages/publications/85165487586?origin=resultslist},
	abstract = {Realizability is an important requirement for reactive system specifications. A reactive system interacts with an environment and responds to input events. Realizability ensures the reactive system behaves as specified, no matter how its environment provides input. Typically, reactive system specifications are given using linear temporal logic (LTL), and they can be tested to ascertain whether the specification is realizable. However, the LTL specification realizability problem is 2EXPTIME-complete, which hinders its application to large-scale systems. In this article, we present a modularization method to mitigate this computational challenge.  © 2021 The British Computer Society. All rights reserved.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Bhar2026132938,
	author = {Bhar, Anirban and Dasgupta, Suparna and Saha, Soumyabrata and Jena, Amrut Ranjan and Karmakar, Koushik and Banerjee, Shubhendu and Roy, Pushpita and Mondal, Bikas and Bhattacharyya, Soumya and Nath, Sudarshan and Dutta, Pallav},
	title = {Context-Aware Predictive Optimization of Non-Functional Requirement Conflicts in DevOps Using Machine Learning},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {132938 - 132950},
	doi = {10.1109/ACCESS.2026.3727789},
	url = {https://www.scopus.com/pages/publications/105049462530?origin=resultslist},
	abstract = {Modern DevOps ecosystems operate in highly dynamic environments where multiple non-functional requirements (NFRs), such as performance, security, and reliability, must be satisfied simultaneously. However, these requirements often exhibit conflicting behaviors under varying runtime conditions, leading to degradation in system quality. Existing approaches primarily focus on either conflict detection or runtime optimization, with limited integration of predictive and adaptive mechanisms. This paper proposes a predictive optimization framework that integrates event log mining, cost-sensitive machine learning, and multi-objective optimization to proactively manage NFR conflicts in DevOps environments. The framework extracts contextual features from event logs and combines them with runtime monitoring and software repository metrics to construct a comprehensive feature space. A cost-sensitive Random Forest model is employed to predict conflict likelihood while prioritizing high-impact conflicts. Upon prediction, a multi-objective optimization module based on NSGA-II dynamically identifies optimal NFR operationalizations. Experimental evaluation using multi-source datasets demonstrates that the proposed framework achieves an accuracy of 92.4% and an AUC of 0.95, with an average conflict reduction of 41%. Statistical validation using paired t-tests confirms the significance of improvements (p < 0.05). These results indicate the effectiveness of integrating contextual intelligence with predictive modeling and optimization for proactive NFR conflict management in DevOps systems. © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

