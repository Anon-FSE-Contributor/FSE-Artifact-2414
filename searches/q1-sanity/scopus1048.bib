@CONFERENCE{Zhang2025,
	author = {Zhang, Luxi and Mei, Yuxin and Han, Xu and Liu, Jing},
	title = {ETELTLf: A Recursive Embedding Approach for LTLf Satisfiability Checking in CPSs},
	year = {2025},
	journal = {Proceedings of the International Joint Conference on Neural Networks},
	pages = {},
	doi = {10.1109/IJCNN64981.2025.11228831},
	url = {https://www.scopus.com/pages/publications/105023988820?origin=resultslist},
	abstract = {Linear Temporal Logic over Finite Traces (LTL<sub>f</sub>) is a formalism derived from classical linear temporal logic (LTL). It is primarily applicable to systems and tasks that require verification or validation within a limited time frame, particularly in the domain of artificial intelligence. It also effectively addresses the specific requirements of Cyber-Physical Systems (CPSs). The behavior of CPSs is typically represented by state trajectories. LTL<sub>f</sub> can describe the goals or safety requirements of the system. To verify whether the trajectory of CPSs satisfies the behavior planning and anomaly detection specified by a given logical formula, LTL<sub>f</sub> satisfiability checking is typically performed. Typically, many studies employ advanced approaches based on symbolic checkers, which incur significant additional time costs. Therefore, we propose EELTLf, a novel model based on recurrent neural networks that achieves strong performance while significantly reducing time costs. EELTLf integrates expression tree embedding (ETE) with LTL<sub>f</sub> formulas, enabling simultaneous modeling of temporal reasoning and mathematical computation within a unified framework. By sharing the embedding space and utilizing the cross-operator attention mechanism, this approach effectively captures the interaction between logical operators and mathematical expressions, thereby obtaining the semantic features of LTL<sub>f</sub> formulas. The modeling analysis is conducted based on the permutation and substitution invariance in the semantics of the formula, and the Binary Classification method is ultimately employed to normalize the output. Experimental results show that our approach performs exceptionally well on randomly synthesized datasets, achieving significant improvements across various metrics compared to the state-of-the-art neural network approach LTLfNet. Notably, our approach achieves an average recall value of up to 99.9%. The source code is available at https://anonymous.4open.science/r/ETELTLfDF46. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

