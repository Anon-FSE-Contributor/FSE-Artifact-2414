@ARTICLE{Herrmann2006917,
	author = {Herrmann, Andrea and Paech, Barbara and Plaza, Damian},
	title = {ICRAD: An integrated process for the solution of requirements conflicts and architectural design},
	year = {2006},
	journal = {International Journal of Software Engineering and Knowledge Engineering},
	volume = {16},
	number = {6},
	pages = {917 - 950},
	doi = {10.1142/S021819400600304X},
	url = {https://www.scopus.com/pages/publications/33846589689?origin=resultslist},
