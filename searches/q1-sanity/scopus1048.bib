	author = {Liubinskyi, B.B. and Zvarych, M.M.},
	title = {A Graph-Based Model for Automatic Test Case Generation from Textual Requirements with Hierarchical Coverage; [Графова модель автоматичного генерування тестових випадкiв з тестових вимог з iєрархiчним покриттям]},
	year = {2026},
