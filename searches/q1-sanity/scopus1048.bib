@CONFERENCE{Otani2020,
	author = {Otani, Mayu and Nakashima, Yuta and Rahtu, Esa and Heikkilä, Janne},
	title = {Uncovering Hidden Challenges in Query-Based Video Moment Retrieval},
	year = {2020},
	journal = {31st British Machine Vision Conference, BMVC 2020},
