}

@ARTICLE{Schulz2024203,
	author = {Schulz, Tim and Luttermann, Malte and Möller, Ralf},
	title = {AutoRAG: Grounding Text and Symbols},
	year = {2024},
	journal = {KI - Kunstliche Intelligenz},
	volume = {38},
