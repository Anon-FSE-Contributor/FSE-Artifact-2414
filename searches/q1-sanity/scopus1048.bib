	author = {Kacprzak, Magdalena and Niewiadomski, Artur and Penczek, Wojciech and Zbrzezny, Andrzej},
	title = {SMT-Based Satisfiability Checking of Strategic Metric Temporal Logic},
	year = {2023},
	journal = {Frontiers in Artificial Intelligence and Applications},
