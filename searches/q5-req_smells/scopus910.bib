@ARTICLE{Yousaf202246,
	author = {Yousaf, Muhammad Sohaib and Ali, Saqib and Nawaz, Qamar and Afsar, Salman and Mumtaz, Imran and Rashid, Nida},
	title = {Fagan Inspection: A Defects Finding Mechanism in Software Requirements Specification (SRS) Document},
	year = {2022},
