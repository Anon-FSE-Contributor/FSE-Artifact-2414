@CONFERENCE{Oğuz2026360,
	author = {Oğuz, Evin Aslan and Küster, Jochen M. and Schildmann, Felix Lennart},
	title = {Automatic Validation of Use Case Descriptions in Terms of Quality Criteria and Bad Smells via NLP Models and LLMs},
