	doi = {10.1007/978-3-032-29175-2_23},
	url = {https://www.scopus.com/pages/publications/105045094262?origin=resultslist},
	abstract = {Generative AI and large language models (LLMs) are increasingly applied to requirements-based test design, raising expectations for automating the transformation of informal requirements into test artifacts. Prior evaluations of such systems have largely focused on output-level correctness, yet practical adoption often involves human review, interpretation, and revision of AI-generated results. This paper reports an exploratory practitioner log study investigating the interaction-level quality-in-use of generative AI outputs in requirements-based test design. We defined an AI-assisted workflow in which practitioners generate test-case mappings from conditional requirements via equivalence classes. Using 18 real-world embedded-system requirements, practitioners produced 108 mappings. Two practitioners with different experience levels independently reviewed the outputs, classifying them as correct, requiring rewording, or failures. While most mappings were logically correct, 40 mappings required rewording for professional reuse. In addition, a single requirement-level failure was identified at the equivalence-class stage, which propagated to multiple downstream test-case mappings during test design. Failure mode analysis revealed recurring structural patterns underlying this failure case. Interpreted through a quality-in-use perspective informed by the ISO/IEC SQuaRE framework, these findings indicate that output correctness is a necessary but insufficient condition for effective AI assistance. We discuss implications for evaluation practices, reviewer strategies, and tool design, highlighting the importance of interaction-level measures when integrating generative AI into software testing workflows. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

