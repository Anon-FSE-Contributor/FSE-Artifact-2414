	doi = {10.1117/12.3062741},
	url = {https://www.scopus.com/pages/publications/105024946914?origin=resultslist},
	abstract = {Background: The microelectronics industry faces constant challenges in improving the quality control of silicon chip manufacturing. One of them is to quickly detect and diagnose process or equipment drifts in production, as well as enabling very early detection of process marginalities during R&D phase. In previous publication, we have shown that Convolutional Neural Networks (CNN) are of high interest to perform Automatic Defect Classification (ADC) on many types of images gathered during various manufacturing process control steps [1]. More recently, an illustration of a real time CDSEM image computing framework, the ImageLab sandbox, was presented [2], but was mainly focused on contour metrology [3-4]. Aim: In this paper, we are evaluating the natural extension of this “in-house” infrastructure to perform CNN-based ADC on CDSEM images, that were originally produced for metrology and not inspection purposes. Indeed, anomalies can sometimes be seen on the CDSEM images, but those do not disturb the measurement. Since the measurement is within specifications, there is no reason for the manufacturing control system to stop the process, nor the equipment. Because this measurement process is automated, most images are not manually checked. Adding a CNN-based ADC systematic classification on those already existing images could be an efficient way to quickly identify non-quality events. We are also investigating use cases leveraging a dedicated CDSEM images capture step for ADC. Indeed, when defect mechanisms and locations are well known, metrology-SEM based ADC presents various advantages compared to Inspection-SEM that are more suitable for an Inspection – Review mode. Approach: The ImageLab has been presented at SPIE 2022 [5] and EMLC 2023 [2]. It provides real time CDSEM images processing capabilities. In this work, we will focus on AI based solutions, especially open-source CNN (Convolutional Neural Network) architectures. The main interest of such an environment is to enable Big Data approaches, by emulating data collection on production line in parallel of the real production, instead of limiting the use of metrology data to perform single lot analysis. Results: This CNN-based ADC approach on metrology images was successfully proven useful on several use cases, for example in the context of the introduction of a new derivative technology, on top of 4 already existing ones on that node. It allowed R&D engineers to quickly highlight that the new technology’s process integration modifications and product layout influenced the overall process. Our MetroSpection approach was able to detect anomalies even though the CDSEM measurements were within the specification limits. Suited Graphical User Interface clearly illustrates this process deviation, while showing that the other 4 technologies in production were not affected. It also helped to better define where this marginality happened during the process flow, in this case, the last 2 metal levels. Besides the native ADC CNN capability, other challenges are addressed to allow adoption of such capability in a mass production environment. One of these is model training. The first model trained appeared to be not accurate enough and therefore not usable in production because it was too noisy. In fact, sensitivity to CDSEM machine type was predominant. To be able to retrain the model efficiently, appropriate visualization of the last embedded layer results of the first model is performed. This layer is the final and finest data treatment layer used by CNNs before classification and contains the extracted characteristics of the images. The visualization is therefore an illustration of how CNNs interpret our image dataset and can be used to identify weaknesses in classification performances, often exhibited by cluster merging. It also enables data selection using lasso techniques, and re-labeling of the images can be operated, leading to an improved dataset, that will be able to produce, in turn, a better tuned model. Conclusion: The ADC CNN on CDSEM images is now running in production for several use cases. Applications are either for manufacturing control or R&D. Use cases for this approach are numerous and some of them will be presented in this paper. Promising user friendly tools are also in development to increase and speed up mass production environment adoption. © 2025 SPIE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Shi2023,
	author = {Shi, Jianwei},
	title = {Ensuring Software Quality through Videos in Requirements Engineering},
	year = {2023},
	journal = {CEUR Workshop Proceedings},
	volume = {3378},
	pages = {},
	url = {https://www.scopus.com/pages/publications/85158926805?origin=resultslist},
	abstract = {Complex software systems are drafted, specified, and implemented in cooperation of all stakeholders. A shared understanding of requirements is important in all phases. However, requirements engineers, customers, developers, testers, and other stakeholders do not have a shared understanding of requirements due to insufficient communication. To solve this problem, this paper proposes to use videos to facilitate stakeholder involvement in requirements engineering. The basic idea is to use vision videos and test videos in requirements engineering with the help of testing techniques. A vision video visualises a future software system with a motivation and an envisioned solution. Requirement engineers use vision videos to elicit testable requirements from stakeholders and then validate the elicited requirements. A test video shows test executions of a software under development. Developers use test videos for (1) clarification of misunderstood requirements among development team and (2) eliciting new requirements and collecting feedback from stakeholders. Experiments and case studies are planned to check the effectivity or efficiency of these methods. The testability of a software is shaped at the beginning through defining testable requirements. During development, these requirements are updated through stakeholders’ feedback. Hence, using video in requirements engineering ensures software quality. © 2023 Copyright for this paper by its authors. Use permitted under Creative Commons License Attribution 4.0 International (CC BY 4.0).},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Kureshi2022,
	author = {Kureshi, Rameez Raja and Mishra, Bhupesh Kumar and Thakker, Dhavalkumar and John, Reena and Walker, Adrian and Simpson, Sydney and Thakkar, Neel and Wante, Agot Kirsten},
	title = {Data-Driven Techniques for Low-Cost Sensor Selection and Calibration for the Use Case of Air Quality Monitoring},
	year = {2022},
	journal = {Sensors},
	volume = {22},
	number = {3},
	pages = {},
	doi = {10.3390/s22031093},
	url = {https://www.scopus.com/pages/publications/85123625958?origin=resultslist},
	abstract = {With the emergence of Low-Cost Sensor (LCS) devices, measuring real-time data on a large scale has become a feasible alternative approach to more costly devices. Over the years, sensor technologies have evolved which has provided the opportunity to have diversity in LCS selection for the same task. However, this diversity in sensor types adds complexity to appropriate sensor selection for monitoring tasks. In addition, LCS devices are often associated with low confidence in terms of sensing accuracy because of the complexities in sensing principles and the interpretation of monitored data. From the data analytics point of view, data quality is a major concern as low-quality data more often leads to low confidence in the monitoring systems. Therefore, any applications on building monitoring systems using LCS devices need to focus on two main techniques: sensor selection and calibration to improve data quality. In this paper, data-driven techniques were presented for sensor calibration techniques. To validate our methodology and techniques, an air quality monitoring case study from the Bradford district, UK, as part of two European Union (EU) funded projects was used. For this case study, the candidate sensors were selected based on the literature and market availability. The candidate sensors were narrowed down into the selected sensors after analysing their consistency. To address data quality issues, four different calibration methods were compared to derive the best-suited calibration method for the LCS devices in our use case system. In the calibration, meteorological parameters temperature and humidity were used in addition to the observed readings. Moreover, we uniquely considered Absolute Humidity (AH) and Relative Humidity (RH) as part of the calibration process. To validate the result of experimentation, the Coefficient of Determination (R<sup>2</sup>), Root Mean Square Error (RMSE), and Mean Absolute Error (MAE) were compared for both AH and RH. The experimental results showed that calibration with AH has better performance as compared with RH. The experimental results showed the selection and calibration techniques that can be used in designing similar LCS based monitoring systems. © 2022 by the authors. Licensee MDPI, Basel, Switzerland.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 41; All Open Access; Gold Open Access; Green Open Access}
}

@CONFERENCE{Tona202239,
	author = {Tona, Claudia and Juarez-Ramirez, Reyes and Jimenez, Samantha and Lopez, Rafael Gonzalez Pacheco},
	title = {Toward Developing an Ontology for Assessing Quality of User Stories in Scrum Framework},
