@CONFERENCE{Osama2021448,
	author = {Osama, Mohamed and Zaki-Ismail, Aya and Abdelrazek, Mohamed and Grundy, John and Ibrahim, Amani},
	title = {Enhancing NL Requirements Formalisation Using a Quality Checking Model},
	year = {2021},
