	author = {Seki, Yotaro and Hayashi, Shinpei and Saeki, Motoshi},
	title = {Cataloging Bad Smells in Use Case Descriptions and Automating Their Detection},
	year = {2022},
	journal = {IEICE Transactions on Information and Systems},
	volume = {E105D},
