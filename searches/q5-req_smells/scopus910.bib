@CONFERENCE{Aleluia Reis2012459,
	author = {Aleluia Reis, L. and Zachary, D.S. and Peters, Bernhard and Drouet, L.},
	title = {A fast air quality model using Look-up tables to address integrated environmental assessment model requirements},
