@inproceedings{10.1145/3718491.3718633,
author = {Shaikh, Er. Tausif Bashir and Kokate, Mr. Vivek},
title = {A study on Surface Flaw Detection using Deep Learning Approach},
year = {2025},
isbn = {9798400710865},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3718491.3718633},
doi = {10.1145/3718491.3718633},
abstract = {Surface Flaws are always characterised by human eyes. In this article we tackle the problem of surface flaws in metal structures. When surface flaws in metal structures are identified in a timely manner, it is possible to efficiently regulate the quality, wear, and safety of these structures. Numerous neural network topologies that have shown great efficiency in various domains, such as image classification, segmentation, and recognition, have been presented by researchers over the last ten years. We will try to implement a sophisticated model for use in production and maintenance departments, aiding in defect detection, classification, and localization on steel surfaces. The main aims of this project are to investigate Transfer Learning approaches and develop a Layered Deep Learning Pipeline for Classification and Segmentation using Convolutional Neural Networks (CNNs), Residual Networks (ResNet), and U-Net Architecture. The images in the collection each display different kinds of flaws and are labelled to indicate their location on the steel surface. The techniques used include image augmentation, data pre-processing, and building a reliable data generator for effective model training. A ResNet-based classifier will be refined for defect classification using the provided defect and non-defect photos. Simultaneously, a new ResUNet architecture will be created for defect segmentation, leveraging the advantages of residual connections for accurate localization. The goals of this research project are to achieve precise fault localization and high classification accuracy. We believe that the suggested methodology would significantly improve industrial fault detection procedures, resulting in higher operational effectiveness and lower costs. Through extensive experimental analysis conducted with a large dataset containing both defective and normal images, the module demonstrates better accuracy for both classification and segmentation.},
booktitle = {Proceedings of the 4th Asia-Pacific Artificial Intelligence and Big Data Forum},
pages = {884–888},
numpages = {5},
keywords = {Overfitting, Pooling, Principal Component Analysis (PCA), Recurrent Neural Network (RNN), Residual Network (ResNet), Segmentation},
location = {
},
series = {AIBDF '24}
}

@inproceedings{10.1145/123186.123223,
author = {Burch, J. R. and Clarke, E. M. and McMillan, K. L. and Dill, David L.},
title = {Sequential circuit verification using symbolic model checking},
year = {1991},
isbn = {0897913639},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/123186.123223},
doi = {10.1145/123186.123223},
abstract = {The temporal logic model checking algorithm developed by Clarke, Emerson, and Sistla [9] is modified to represent a state graph using binary decision diagrams (BDD's) [4]. Because this representation captures some of the regularity in the state space of sequential circuits with data path logic, we are able to verify circuits with an extremely large number of states. We demonstrate this new technique on a synchronous pipelined design with approximately 5 x 1020 states. Our model checking algorithm handles full CTL with fairness constraints. Consequently, we are able to handle a number of important liveness and fairness properties, which would otherwise not be expressible in CTL. We give empirical results on the performance of the algorithm applied to both synchronous and asynchronous circuits with data path logic.},
booktitle = {Proceedings of the 27th ACM/IEEE Design Automation Conference},
pages = {46–51},
numpages = {6},
location = {Orlando, Florida, USA},
series = {DAC '90}
}

@inproceedings{10.1145/2814251.2814268,
author = {Gammaitoni, Lo{\"i}c and Kelsen, Pierre and Glodt, Christian},
title = {Designing languages using lightning},
year = {2015},
isbn = {9781450336864},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/2814251.2814268},
doi = {10.1145/2814251.2814268},
abstract = {Modelling languages are defined by specifying their abstract syntax, concrete syntax and semantics. In the Lightning tool the definition of all these language components is based on the lightweight formal language Alloy. Lightning makes use of the powerful automatic analysis features of Alloy to allow language designers to develop and validate the definition of a modelling language in an incremental fashion. By providing immediate visual feedback, it allows errors in the language definition to be quickly identified and corrected. Furthermore Lightning introduces F-Alloy, a new Alloy based model transformation language. Transformations expressed in F-Alloy can be efficiently interpreted in Lightning. We illustrate the use of the tool on the language of structured business processes.},
booktitle = {Proceedings of the 2015 ACM SIGPLAN International Conference on Software Language Engineering},
pages = {77–82},
numpages = {6},
keywords = {Lightweight Formal Method, Lightning, Language Workbench, Language Design, Alloy, Agile Design},
location = {Pittsburgh, PA, USA},
series = {SLE 2015}
}

@inproceedings{10.1145/2588548.2588550,
author = {S{\'a}nchez, Jos{\'e} and Leavens, Gary T.},
title = {Static verification of ptolemyrely programs using openJML},
year = {2014},
isbn = {9781450327985},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/2588548.2588550},
doi = {10.1145/2588548.2588550},
abstract = {In the PtolemyRely language event types define events that, when announced, trigger the execution of handlers, passing along the triggering piece of code for its eventual execution.Verification of PtolemyRely programs poses some particular challenges: (1) handlers must be verified against their corresponding event declaration, (2) event announcement and next-handler invocation must be reasoned about according to PtolemyRely's semantics, (3) the body of refining statements must be checked against their specifications, etc. The original Ptolemy compiler includes run-time assertion checking for dynamic verification, but there has been no static verification tool.In this paper we address the challenge of static verification of PtolemyRely programs by encoding them into JML (the Java Modelling Language) and using a JML static verification tool (OpenJML) to discharge the verification obligations. We argue informally that our encoding is sound in the sense that a PtolemyRely program is valid if and only if its encoding is a valid JML program.},
booktitle = {Proceedings of the 13th Workshop on Foundations of Aspect-Oriented Languages},
pages = {13–18},
numpages = {6},
keywords = {static verification, ptolemyrely, ptolemy language, openjml},
location = {Lugano, Switzerland},
series = {FOAL '14}
}

@inproceedings{952786.952792,
author = {Leveson, N. G. and Heimdahl, M. and Hildreth, H. and Reese, J. and Ortega, R.},
title = {Experiences using statecharts for a system requirements specification},
