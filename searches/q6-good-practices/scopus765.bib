	year = {2026},
	journal = {Proceedings of 4th International Conference on Self Sustainable Artificial Intelligence Systems, ICSSAS 2026},
	pages = {811 - 816},
	doi = {10.1109/ICSSAS68835.2026.11559511},
	url = {https://www.scopus.com/pages/publications/105044083706?origin=resultslist},
	abstract = {Quantum-inspired machine learning leverages quantum computing principles on classical hardware for enhanced pattern recognition in cybersecurity applications. This paper presents quantum-inspired neural network architectures for malicious QR code detection and URL threat classification with comprehensive benchmarking against 15 + traditional ML and DL approaches. The proposed quantum-inspired CNN incorporates interference patterns through dual-activation pathways combining ReLU and tanh functions, while the quantum-inspired DNN employs triple interference mechanisms with attention- like gating and multi-path entanglement. Experimental evaluation on 20,000 QR code images demonstrates 100% classification accuracy compared to Random Forest (87.3%), SVM (89.1%), conventional CNN (95.2%), and Inception-v3 (96.8%). URL classification across 20,000 samples spanning four threat categories achieves 94.27% accuracy, outperforming Random Forest (84.6%), SVM (82.1%), conventional DNN (89.3%), LSTM (91.2%), and Transformer (92.8%). The quantum-inspired architectures demonstrate efficient convergence with 28% faster training while maintaining computational overhead within 25-30%. Results validate quantum-inspired approaches as state-of- the-art cybersecurity solutions deployable on conventional GPU infrastructure. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
