@CONFERENCE{Schmitt202115408,
	author = {Schmitt, Frederik and Hahn, Christopher and Rabe, Markus N. and Finkbeiner, Bernd},
	title = {Neural Circuit Synthesis from Specification Patterns},
	year = {2021},
	journal = {Advances in Neural Information Processing Systems},
	volume = {19},
	pages = {15408 - 15420},
	url = {https://www.scopus.com/pages/publications/85131582890?origin=resultslist},
	abstract = {We train hierarchical Transformers on the task of synthesizing hardware circuits directly out of high-level logical specifications in linear-time temporal logic (LTL). The LTL synthesis problem is a well-known algorithmic challenge with a long history and an annual competition is organized to track the improvement of algorithms and tooling over time. New approaches using machine learning might open a lot of possibilities in this area, but suffer from the lack of sufficient amounts of training data. In this paper, we consider a method to generate large amounts of additional training data, i.e., pairs of specifications and circuits implementing them. We ensure that this synthetic data is sufficiently close to human-written specifications by mining common patterns from the specifications used in the synthesis competitions. We show that hierarchical Transformers trained on this synthetic data solve a significant portion of problems from the synthesis competitions, and even out-of-distribution examples from a recent case study. © 2021 Neural information processing systems foundation. All rights reserved.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 13}
}

@ARTICLE{Muflikhun20263171,
	author = {Muflikhun, Muhammad Akhsin},
	title = {Defect and failure detection in laser powder bed fusion: a comprehensive review and experimental validation on AlSi10Mg metal blade},
	year = {2026},
	journal = {International Journal of Advanced Manufacturing Technology},
	volume = {144},
	number = {5-6},
	pages = {3171 - 3194},
	doi = {10.1007/s00170-026-18148-9},
	url = {https://www.scopus.com/pages/publications/105036172289?origin=resultslist},
	abstract = {This study presents a comprehensive evaluation of surface quality and defect characteristics of an AlSi10Mg primary air fan (PAF) component fabricated via LPBF technology, supported by an extensive schematic literature review. The review systematically synthesized peer-reviewed papers (2014–2026) following PRISMA and COPE frameworks, revealing the evolution of LPBF defect research across three thematic clusters: defect formation mechanisms, process parameter effects, and microstructural integrity. This structured study emphasized how process–structure–property–performance (PSPP) relationships govern porosity, melt-pool dynamics, and surface morphology, forming the conceptual basis for the present experimental validation. Experimentally, the PAF component was produced using an SLM 280 HL system to replicate industrial-scale LPBF fabrication. SEM–EDX analyses confirmed Al–Mg as dominant elements, with minimal oxidation and negligible sub-micron voids. Surface profilometry and microscopy identified localized pores up to 100 μm near edge regions, consistent with keyhole and lack-of-fusion porosity mechanisms identified in the literature synthesis. Vickers microhardness tests indicated an average value of 109.39 MHV with stable indentation geometry, while surface roughness mapping revealed deep irregularities (> 20 μm), verifying the persistence of internal voids beneath apparently smooth surfaces. The present study establishes a direct linkage between theoretical defect formation models and real component performance. The findings underscore that optimal control of process parameters—laser power (275–325 W), scan speed (1000–1200 mm/s), hatch spacing (0.10–0.12 mm), and layer thickness (20–40 μm)—is essential for achieving defect-minimized LPBF AlSi10Mg components. This holistic approach advances understanding of LPBF defect evolution and supports the development of standardized evaluation frameworks for industrial-grade additive manufacturing applications in the energy sector. © The Author(s), under exclusive licence to Springer-Verlag London Ltd., part of Springer Nature 2026.},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

