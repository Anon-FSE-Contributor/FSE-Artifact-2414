	pages = {681 - 686},
	doi = {10.1109/BECITHCON69222.2025.11504063},
	url = {https://www.scopus.com/pages/publications/105041032964?origin=resultslist},
	abstract = {In the era of digital job markets, platforms such as Jora Jobs and Job Media enhance employment accessibility but often fail to accommodate the needs of neurodivergent individuals, including those with Autism Spectrum Disorder (ASD), ADHD, OCD, and Dyslexia. This study aims to assess the usability of job-hunting applications for neurodivergent users through heuristic evaluation and to design an inclusive prototypical application with improved accessibility features. To achieve this, two widely used job-hunting applications in the context of Bangladesh such as Jora Jobs and Job Media were selected. A customized set of Design Requirement Specifications (DRS) was developed through a literature review to guide the evaluation of these applications. Using a heuristic expert evaluation approach, multiple usability issues were identified in both applications. Based on these findings and the derived DRS, an inclusive prototypical application was designed to enhance usability for neurodivergent users. The prototype was further evaluated using the same DRS, and its results were compared with those of the original applications. The comparison indicates that incorporating DRS in the development of job-portal applications significantly improves usability for neurodivergent users. Overall, the findings highlight the effectiveness of inclusive design in enhancing digital employment platforms for neurodivergent individuals. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

