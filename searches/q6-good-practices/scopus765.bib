@ARTICLE{Carvalho2023,
	author = {Carvalho, Daniel and Marques, Sandra and Siqueira, Giorgia and Ferreira, Armando and Santos, João and Geraldo, Dulce and Castro, Cidália R. and Machado, Ana V. and Vaz, Filipe and Lopes, Cláudia},
