@ARTICLE{Kanakaratne2026,
	author = {Kanakaratne, Vidura and Behvar, Alireza and Baffour, Francis A. and Bajaj, Harsh and Algamal, Anwar and Celebi, Ahu and Elahinia, Mohammad},
	title = {Sinter-based additive manufacturing of NiTiHf shape memory alloys: a comprehensive review of binder jetting approaches, challenges, and prospects},
	year = {2026},
	journal = {Smart Materials and Structures},
	volume = {35},
	number = {4},
	pages = {},
	doi = {10.1088/1361-665X/ae57ee},
	url = {https://www.scopus.com/pages/publications/105035511611?origin=resultslist},
	abstract = {NiTiHf shape memory alloys (SMAs) have garnered increasing attention due to their elevated transformation temperatures (TTs), enhanced strength, and stable superelasticity, outperforming binary NiTi in demanding environments. The addition of hafnium enables TTs exceeding 500 °C, while also influencing microstructure through the formation of strengthening H-phase precipitates. However, NiTiHf processing remains challenging due to compositional sensitivity, oxidation, and the need for precise thermal control. Binder jetting additive manufacturing (BJAM), a non-fusion powder-based AM technique, presents a promising solution. BJAM offers low thermal gradients, high geometric flexibility, and excellent compositional fidelity, traits particularly advantageous for complex, metastable ternary SMAs like NiTiHf. This review systematically discusses NiTiHf SMAs, including compositional effects, phase transformation pathways, thermal hysteresis behavior, and mechanical performance. It further evaluates the principles, advantages, and limitations of BJAM and highlights its potential for producing near-net-shape NiTiHf components with reduced residual stress and customizable microstructures. Finally, the review identifies critical research gaps in BJAM-processed NiTiHf and outlines future directions involving process optimization, powder design, and integration of modeling tools such as CALPHAD and machine learning. By bridging alloy design with advanced manufacturing, this work aims to support the scalable production of next-generation high-performance SMAs. © 2026 The Author(s). Published by IOP Publishing Ltd.},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Hybrid Gold Open Access}
}

