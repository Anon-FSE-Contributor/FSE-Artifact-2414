	abstract = {In recent years, extended short-wave infrared (eSWIR, 1-3 μm) detection has attracted increasing attention across industry, defense, astronomy, and Earth observation. Conventional InGaAs photodiodes on InP are limited to 1.7 μm, while II-VI alternatives such as HgCdTe face epitaxial and cost challenges. III-V superlattices (SLs) represent a promising solution, enabling longer cutoff wavelengths with higher operating temperatures and simplified growth. The III-V Lab developed strain-compensated InGaAs/InAs/GaAsSb SLs on InP with lattice mismatch up to ±5,000 ppm as part of the SWIR Up research program, and in collaboration with Thales LAS and the Marseille Astrophysics Laboratory, characterized photodiode and FPA samples. This strategy mitigates carrier localization and mass anisotropy, while improving vertical transport and is expected to preserve the modulation transfer function (MTF). Photodiodes and focal plane arrays (FPAs) demonstrate enhanced quantum efficiency and carrier mobility, with detection up to 2.5 μm. FPA performance is further evaluated through MTF, dark current, noise, and uniformity, providing an end-to-end perspective on the potential and remaining challenges of SL-based eSWIR detectors.  © COPYRIGHT SPIE. Downloading of the abstract is permitted for personal use only.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

