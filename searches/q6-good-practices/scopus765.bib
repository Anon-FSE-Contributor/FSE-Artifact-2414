	year = {2009},
	journal = {IET Software},
	volume = {3},
	number = {2},
	pages = {69 - 90},
	doi = {10.1049/iet-sen.2008.0022},
	url = {https://www.scopus.com/pages/publications/64549150632?origin=resultslist},
