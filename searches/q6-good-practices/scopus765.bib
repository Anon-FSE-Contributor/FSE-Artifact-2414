	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

@CONFERENCE{Pomerantseva2013,
	author = {Pomerantseva, Ekaterina and Gerasopoulos, Konstantinos and Gnerlich, Markus and Odenwald, Philipp and Culver, James and Ghodssi, Reza},
	title = {Using Tobacco mosaic virus template for the fabrication of three-dimensional hierarchical microbattery electrodes with high energy and high power density},
	year = {2013},
