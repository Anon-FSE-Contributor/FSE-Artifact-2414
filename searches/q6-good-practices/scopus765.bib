@CONFERENCE{Marchetto2017517,
	author = {Marchetto, Guido and Sisto, Riccardo and Virgilio, Matteo and Yusupov, Jalolliddin},
	title = {A Framework for User-Friendly Verification-Oriented VNF Modeling},
	year = {2017},
	journal = {Proceedings - International Computer Software and Applications Conference},
