@CONFERENCE{Szymsza202614,
	author = {Szymsza, Jakub and Franken, Gertjan and Vanderlinden, Vik and Van Goethem, Tom and Vanhoef, Mathy and Desmet, Lieven},
	title = {Origin Story: A Comprehensive Lifecycle Analysis of Same-Origin Policy Bugs},
	year = {2026},
	journal = {SecDev 2026 - Proceedings of the 2026 ACM Secure Development Conference, Co-located with FSE 2026},
	pages = {14 - 29},
	doi = {10.1145/3805773.3805993},
	url = {https://www.scopus.com/pages/publications/105045279771?origin=resultslist},
	abstract = {The Same-Origin Policy (SOP) serves as the web’s fundamental security mechanism, isolating resources between different web origins to prevent malicious cross-site interactions. Despite its critical role, the SOP lacks a unified formal specification and has evolved informally over decades, resulting in a fragmented implementation landscape prone to bypasses and inconsistencies. While prior research has examined specific SOP flaws, no study has systematically analyzed how these bugs are introduced and resolved throughout their lifecycle. We address this gap by conducting the first comprehensive lifecycle analysis of 97 SOP security bugs across Chromium and Firefox, enabled by our extensions to BugHog-a framework previously used on Content Security Policy (CSP) bugs. Our findings reveal that 94% of all SOP bugs stem from non-security code revisions, such as functional bug fixes or the addition of new web features, which contrasts sharply with previously identified CSP bug causes. This, compounded by inconsistent bug labeling, cross-vendor disagreement on what constitutes an SOP bug, and the vast scope of the SOP, makes it exceptionally difficult for developers to foresee the security implications of their changes. The severity of this issue is further underscored by our discovery of three publicly disclosed vulnerabilities that remained active across the latest versions of Chromium, Firefox, and Safari. Beyond showing that bug patterns are not generalizable across different browser security policies, we propose actionable recommendations for standardization and improved bug categorization. © 2026 Copyright held by the owner/author(s).},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

