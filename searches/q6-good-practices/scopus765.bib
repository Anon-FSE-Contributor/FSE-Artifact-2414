	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Siddiqui2024,
	author = {Siddiqui, Yusra and Khan, Imran Ullah and Saeed, Syed Hasan},
	title = {A Comprehensive Review Of Junctionless Transistors},
	year = {2024},
	journal = {2024 2nd International Conference Computational and Characterization Techniques in Engineering and Sciences, IC3TES 2024},
	pages = {},
	doi = {10.1109/IC3TES62412.2024.10877552},
	url = {https://www.scopus.com/pages/publications/86000030506?origin=resultslist},
	abstract = {Owing to the advancements in the field of technology, the interspace between the junctions has been reduced to under 10 nm. Consequently, mandating exceedingly high concentration gradients. Intricacy in fabrication becomes the aftermath. Junctionless transistors serve as an alternative. In contrast to the classical MOSFET, a Junctionless transistor features identical doping in the source, channel, and drain regions, leading to a negligible concentration gradient. The Junctionless transistor switches off because of the variation in the work function of the semiconductor and the material of the gate. Transistors without junctions provide a substantial edge compared to conventional MOSFET devices. Their advantage lies in the non-existence of a p-n junction, leading to a simplified fabrication process. Improved short-channel effects are a perk. Ever since the fabrication of the initial Junctionless transistors, several other transistors of this kind, with structure variations, doping and gates have been proposed and investigated. This review paper aims to offer a straightforward yet comprehensive analysis of JLTs introduced in the past few years. It is observed that DG JLFET has a superior performance for different doping profiles than single gate. AlGaN/GaN FinFETs exhibit higher off state current than the GaN JL FinFETs. It is reported that InGaAs when compared to classical JLFETs have lesser deterioration owing to impurity scattering. When a germanium junctionless GAAFETs was compared to silicon one, it reported, reduced DIBL, Ion/Ioff ratio and SS. The Ge JLFET also exhibit a higher band gap of 2.36 eV when the film thickness in 1nm. It reduces to 0.86 eV when the film thickness is 3nm. © 2024 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@ARTICLE{Olszewska20201,
	author = {Olszewska, Marta and Shokri-Manninen, Fatima and Edmunds, Andrew and Waldén, Marina},
	title = {Applying guidelines for system modelling in Event-B – a systematic literature review},
	year = {2020},
	journal = {International Journal of Critical Computer-Based Systems},
	volume = {10},
	number = {1},
	pages = {1 - 36},
	doi = {10.1504/IJCCBS.2020.108668},
	url = {https://www.scopus.com/pages/publications/85093868786?origin=resultslist},
	abstract = {Developing safety-critical systems is an intricate task since it involves the application of well-established and rigorous methods, supported by good practices. The modelling is merely a part of this undertaking. However, it plays a significant role in the description of the system, how it will behave and what properties it will have. Formal methods, for instance Event-B, are utilised in such cases to assure that the system is correct-by-construction and functions as required. In this work we use a literature review method to collect a body of knowledge that would support the Event-B practitioners with modelling guidelines. We first define the domains in which the guidelines fall and divide them into two categories: beginners and advanced. Then we provide a collection of guidelines as reinforcements for domain-specific applications of Event-B. Copyright © 2020 Inderscience Enterprises Ltd.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Green Open Access}
}

@CONFERENCE{Prasetya2020437,
	author = {Prasetya, I.S.W.B. and Leek, Craig Q.H.D. and Oosenbrug, Roan and Kostic, Petar and Vries, Mike De},
	title = {Can Learning Formal Specification Be Fun? - Experience and Perspective},
	year = {2020},
	journal = {Proceedings - 2020 IEEE 13th International Conference on Software Testing, Verification and Validation Workshops, ICSTW 2020},
