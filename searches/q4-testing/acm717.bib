abstract = {This paper describes a framework for automatic functional testing based on formal specifications. The framework is intended to expose all of the issues that must be addressed in automatic testing, to provide solutions for some of the major challenges, and to serve as a foundation for developing tool support in the future.},
booktitle = {Proceedings of the 6th International Workshop on Automation of Software Test},
pages = {107–108},
numpages = {2},
keywords = {automatic testing, specification-based testing, testing framework},
location = {Waikiki, Honolulu, HI, USA},
series = {AST '11}
}

@inproceedings{1870926.1871339,
author = {Verbeek, Freek and Schmaltz, Julien},
title = {Formal specification of networks-on-chips: deadlock and evacuation},
year = {2010},
isbn = {9783981080162},
publisher = {European Design and Automation Association},
address = {Leuven, BEL},
abstract = {Networks-on-chips (NoC) are emerging as a promising interconnect solution for efficient Multi-Processors Systems-on-Chips. We propose a methodology that supports the specification of parametric NoCs. We provide sufficient constraints that ensure deadlock-free routing, functional correctness, and liveness of the design. To illustrate our method, we discharge these constraints for a parametric NoC inspired by the HERMES architecture.},
booktitle = {Proceedings of the Conference on Design, Automation and Test in Europe},
pages = {1701–1706},
numpages = {6},
location = {Dresden, Germany},
series = {DATE '10}
}

@inproceedings{10.1145/3328433.3328462,
author = {Franceschini, Luca},
title = {RML: runtime monitoring language: a system-agnostic DSL for runtime verification},
year = {2019},
isbn = {9781450362573},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3328433.3328462},
doi = {10.1145/3328433.3328462},
abstract = {Runtime verification (RV) [11] is a form of verification happening at runtime rather than compile-time. While static verification proves whether a property holds for every possible run of the program under scrutiny, RV only deals with a single execution (at a time). RV offers more flexibility in terms of provable properties: some specifications that may be particularly hard (or even impossible) to enforce statically can be checked at runtime, when more information are available.},
booktitle = {Companion Proceedings of the 3rd International Conference on the Art, Science, and Engineering of Programming},
articleno = {28},
numpages = {3},
keywords = {RML, language, monitor, runtime, trace, verification},
location = {Genova, Italy},
series = {Programming '19}
