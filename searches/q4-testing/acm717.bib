year = {2006},
isbn = {1595933816},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/1146909.1147120},
doi = {10.1145/1146909.1147120},
abstract = {In this paper, we present methods for automatic test generation from formal specifications.These are used to create intelligent test benches that are able to cover corner case behaviors in much less time.We have developed a prototype tool for intelligent test generation within the layered test bench architecture proposed in RVM.We present results on verification IPs of standard bus protocols to show the effectiveness of our approach.},
