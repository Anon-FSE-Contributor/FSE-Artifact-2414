@ARTICLE{Zhang2025,
	author = {Zhang, Renquan and Tai, Jilei and Yao, Qing and Yang, Wan and Ruggeri, Kai and Shaman, Jeffrey and Pei, Sen},
	title = {Behavior-driven forecasts of neighborhood-level COVID-19 spread in New York City},
	year = {2025},
	journal = {PLoS Computational Biology},
