@ARTICLE{Alotaibi20261,
	author = {Alotaibi, Daifallah Zaid},
	title = {An Intelligent Framework for Automated Software Requirement Analysis and Test Case Generation Using Large Language Models},
	year = {2026},
	journal = {International Journal of Embedded and Real-Time Communication Systems},
