@ARTICLE{Legunsen2019795,
	author = {Legunsen, Owolabi and Al Awar, Nader and Xu, Xinyue and Hassan, Wajih Ul and Roşu, Grigore and Marinov, Darko},
	title = {How effective are existing Java API specifications for finding bugs during runtime verification?},
