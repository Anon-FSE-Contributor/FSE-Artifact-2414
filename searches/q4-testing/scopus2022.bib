	volume = {13688},
	pages = {},
	doi = {10.1117/12.3075676},
	url = {https://www.scopus.com/pages/publications/105013070639?origin=resultslist},
	abstract = {The microstructural characteristics of additively manufactured titanium alloys play a crucial role in determining their mechanical properties. Non-destructive evaluation of these microstructures is essential for ensuring the quality of additively manufactured components. This paper explores a non-contact, non-destructive testing simulation method for additively manufactured titanium alloys based on laser ultrasonics. First, a titanium alloy microstructural model was constructed in Matlab using the Voronoi principle. Then, laser ultrasonic testing was simulated in the established titanium alloy model using Comsol software to analyze the propagation characteristics of ultrasonic waves in various grain structures. The results demonstrate that grain boundaries introduce substantial noise into ultrasonic signals. Among the models analyzed, the columnar grain structure, due to its high grain density, exhibits the greatest signal attenuation and noise amplitude, whereas equiaxed grains (especially those with larger sizes) and the blank control group show lower noise levels. These simulations validate the feasibility of laser ultrasonic testing in characterizing the microstructural features of additively manufactured titanium alloys, offering a theoretical foundation for real-time online detection. © 2025 SPIE.},
	type = {Conference paper},
	publication_stage = {Final},
