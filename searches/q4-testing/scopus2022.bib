@ARTICLE{Dadeau2019865,
	author = {Dadeau, Frédéric and Fourneret, Elizabeta and Bouchelaghem, Abir},
	title = {Temporal property patterns for model-based testing from UML/OCL},
	year = {2019},
	journal = {Software and Systems Modeling},
	volume = {18},
