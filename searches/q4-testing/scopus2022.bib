@CONFERENCE{Pandit2025825,
	author = {Pandit, Pooja Diwakar and Gregory, Joe and Fiore, Hunter and Salado, Alejandro},
	title = {An Ontological Representation of the UML Testing Profile for Digital Test and Evaluation},
	year = {2025},
	journal = {Proceedings - 2025 ACM/IEEE 28th International Conference on Model Driven Engineering Languages and Systems Companion, MODELS-C 2025},
