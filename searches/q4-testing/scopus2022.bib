@ARTICLE{Saboori20141275,
	author = {Saboori, M. and Champliaud, H. and Gholipour, J. and Gakwaya, A. and Savoie, J. and Wanjara, P.},
	title = {Evaluating the flow stress of aerospace alloys for tube hydroforming process by free expansion testing},
	year = {2014},
	journal = {International Journal of Advanced Manufacturing Technology},
