}

@ARTICLE{Hongsuchon20251,
	author = {Hongsuchon, Tanaporn and Chen, Shih-Chih and Khan, Asif},
	title = {Applying the S-O-R model to explore impulsive buying behavior driven by inﬂuencers on social commerce websites},
	year = {2025},
	journal = {PeerJ Computer Science},
