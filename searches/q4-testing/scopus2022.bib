	title = {Explainable Online Monitoring of Metric First-Order Temporal Logic},
	year = {2024},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
	volume = {14570 LNCS},
	pages = {288 - 307},
	doi = {10.1007/978-3-031-57246-3_16},
	url = {https://www.scopus.com/pages/publications/85192166399?origin=resultslist},
	abstract = {Metric first-order temporal logic (MFOTL) is an expressive formalism for specifying temporal and data-dependent constraints on streams of time-stamped, data-carrying events. It serves as the specification language of several runtime monitors. These monitors input an MFOTL formula and an event stream prefix and output satisfying assignments to the formula’s free variables. For complex formulas, it may be unclear why a certain assignment is output. We propose an approach that accompanies assignments with detailed explanations, in the form of proof trees. We develop a new monitor that outputs such explanations. Our tool incorporates a formally verified checker that certifies the explanations and a visualization that allows users to interactively explore and understand the outputs. © The Author(s) 2024.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Liu2026,
	author = {Liu, Xiaoqing and Zhang, Chenliang},
	title = {Digital Twin-Driven Monitoring System for Multi-Axis CNC Machining Processes: A Case Study on Aluminium Alloy Impeller Fabrication},
	year = {2026},
	journal = {2026 IEEE 2nd International Conference on Quantum Photonics, Artificial Intelligence and Networking, QPAIN 2026},
	pages = {},
	doi = {10.1109/QPAIN69676.2026.11546578},
	url = {https://www.scopus.com/pages/publications/105042718719?origin=resultslist},
	abstract = {The growing sophistication of multi-axis CNC machining has led to the development of the requirement for intelligent monitoring systems that can record dynamic process behaviour and identify instability in real time. This project aims to create and test a monitoring system based on Digital Twin-driven monitoring and applied to a multi-axis CNC machining process, with the impeller fabrication of aluminium alloys as an example. An approach based on a simulation-based case study was selected, where machining data were simulated with a physics-informed Digital Twin, and its behaviour was analysed with multivariate time-series-based modelling in order to evaluate process behaviour and anomaly separability. The findings indicate very obvious behavioural variations between normal and anomalous machining runs. The study indicates consistent variances among temperature, vibration, spindle power, and cutting force, and the study indicate different distributions of the forecast error scores, with the normal machining runs having a higher mean score (0.29) than the anomalous machining ones (0.11). These results support the usefulness of the suggested monitoring framework in identifying machining conditions according to the dynamics of time. The paper concludes that Digital Twins based on simulation can offer strong and interpretable monitoring in the context of CNC machining. To make future work more adaptive to a closed loop, it is suggested to extend the framework. In practice, the machine is an economical way of monitoring machining instability earlier. One of the major weaknesses is that it relies on the simulated data that are not experimentally tested. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Baumeister2025393,
	author = {Baumeister, Jan and Correnson, Arthur and Finkbeiner, Bernd and Scheerer, Frederik},
	title = {An Intermediate Program Representation for Optimizing Stream-Based Languages},
	year = {2025},
	journal = {Lecture Notes in Computer Science},
	volume = {15933 LNCS},
	pages = {393 - 407},
	doi = {10.1007/978-3-031-98682-6_20},
	url = {https://www.scopus.com/pages/publications/105017230387?origin=resultslist},
	abstract = {Stream-based runtime monitors are safety assurance tools that check at runtime whether the system’s behavior satisfies a formal specification. Specifications consist of stream equations, which relate input streams, containing sensor readings and other incoming information, to output streams, representing filtered and aggregated data. This paper presents a framework for the stream-based specification language RTLola. We introduce a new intermediate representation for stream-based languages, the StreamIR, which, like the specification language, operates on streams of unbounded length; while the stream equations are replaced by imperative programs. We present a set of optimizations based on static analysis of the specification and have implemented an interpreter and a compiler for several target languages. In our evaluation, we measure the performance of several real-world case studies. The results show that the new StreamIR framework reduces the runtime significantly compared to the existing RTLola interpreter. We evaluate the effect of the optimizations and show that significant performance gains are possible beyond the optimizations of the target language’s compiler. While our current implementation is limited to RTLola, the StreamIR is designed to accommodate other stream-based languages, enabling their interpretation and compilation into all available target languages. © The Author(s) 2025.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Zhao2024482,
	author = {Zhao, Deng and Zhou, Zhangbing and Zhang, Wenbo and Deng, Shuiguang and Xue, Xiao and Gaaloul, Walid},
	title = {CSTL: Compositional Signal Temporal Logic for Adaptive Edge Service Monitoring},
	year = {2024},
	journal = {IEEE Transactions on Services Computing},
	volume = {17},
	number = {2},
	pages = {482 - 496},
	doi = {10.1109/TSC.2024.3355133},
	url = {https://www.scopus.com/pages/publications/85182941628?origin=resultslist},
	abstract = {Edge service monitoring is essential to guarantee the healthy of service compositions at runtime. Current techniques focus mostly on the monitoring of atomic edge services, but they are inadequate for that of inter- and composite services. Besides, constraints to be monitored are usually pre-specified, although certain parameters may have to be adapted online according to the execution context. To address these challenges, this paper formulates the problem of edge service monitoring as the interpretation of temporal constraints and time-dependent QoS constraints upon intra-, inter-, and composite services. Leveraging our proposed Compositional Signal Temporal Logic (CSTL) with extended compositional modalities and online parameter settings, an adaptive monitoring mechanism is developed, where constraints are converted to CSTL formulae, and QoS variations and temporal violations are interpreted qualitatively and quantitatively at runtime. Extensive experiments are conducted upon publicly-available datasets, and evaluation results show that CSTL performs better than baseline techniques in terms of expressiveness, applicability, and robustness.  © 2008-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
