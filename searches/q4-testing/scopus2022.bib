	year = {2026},
	journal = {2026 IEEE 4th International Conference on Control, Electronics and Computer Technology, ICCECT 2026},
	pages = {238 - 242},
	doi = {10.1109/ICCECT68671.2026.11565173},
	url = {https://www.scopus.com/pages/publications/105044240020?origin=resultslist},
	abstract = {The installation of complex industrial equipment involves intricate components such as rigid pipelines, flexible wiring harnesses, and large sub-assemblies. This process is characterized by dense component arrangements, mutual occlusions, and strict installation sequences. Traditional visual inspection methods, which rely primarily on instantaneous object detection, often fail to distinguish between 'presence' and 'correctly installed' states, leading to high misjudgment rates. To address this challenge, this paper proposes a novel installation progress monitoring method that integrates the state-of-the-art YOLOv11 deep learning model with a Deterministic Spatio-Temporal Constraint Mechanism (STCM). Unlike standard approaches, we model the installation process as a state transition problem. A spatial verification module utilizing 'Golden Standard' templates is introduced to filter background interference, while a Temporal Finite State Machine (FSM) is employed to eliminate transient detection noise caused by camera jitter or operator hand movements. Furthermore, a dependency inference rule is designed to logically determine the status of visually occluded components. Experimental results demonstrate that the proposed method achieves a mean Average Precision (mAP @ 0.5) of 98.2 % and F1-score of 0.98. Ablation studies confirm that the introduction of logic constraints significantly improves the stability of state estimation in complex industrial environments.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

