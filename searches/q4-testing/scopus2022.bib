	url = {https://www.scopus.com/pages/publications/105035836587?origin=resultslist},
	abstract = {Socio-technical systems need to increasingly account for human emotions and behaviors to effectively influence their decisions without compromising experience. The Internet of Behaviors (IoB) paradigm emphasizes closing the loop between sensing human behavior, system adaptation, and behavior change. This paper proposes Affective Behavior-Driven Adaptation for IoB (ABDA-IoB), a framework that integrates affective computing and behavior analytics into adaptive systems. The ABDA-IoB model defines key modules (Affective Computing, Behavior Analytics, Adaptation Policy Generator) and explicit feedback loops connecting human Quality of Experience (QoE) with system Quality of Service (QoS), enabling continuous adaptation. The framework supports the development of a reinforcement learning-based nudging system for energy conservation. We implement a prototype smart-home dashboard that monitors users' real-time emotional state (via facial expression analysis) and energy-use context, and adapts its feedback strategy through a model-free reinforcement learning agent. Experiments over multiple sessions provide empirical validation: participants in the affect-adaptive condition showed significantly higher positive affect, sustained engagement, and improved simulated energy-saving behavior compared to a static feedback baseline. Results show that ABDA-IoB's emotionally intelligent nudging leads to more receptive and effective behavior change interventions, without causing user discomfort. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@ARTICLE{Benea2025,
	author = {Benea, Lidia and Neaga, Veaceslav and Bogatu, Nicoleta and Axente, Elena Roxana},
