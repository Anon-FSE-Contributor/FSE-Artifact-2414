@ARTICLE{Woodlief2025,
	author = {Woodlief, Trey and Toledo, Felipe and Elbaum, Sebastian and Dwyer, Matthew B.},
	title = {The SGSM framework: Enabling the specification and monitor synthesis of safe driving properties through scene graphs},
	year = {2025},
	journal = {Science of Computer Programming},
	volume = {242},
	pages = {},
	doi = {10.1016/j.scico.2024.103252},
	url = {https://www.scopus.com/pages/publications/85211193567?origin=resultslist},
	abstract = {As autonomous vehicles (AVs) become mainstream, assuring that they operate in accordance with safe driving properties becomes paramount. The ability to specify and monitor driving properties is at the center of such assurance. Yet, the mismatch between the semantic space over which typical driving properties are asserted (e.g., vehicles, pedestrians) and the sensed inputs of AVs (e.g., images, point clouds) poses a significant assurance gap. Related efforts bypass this gap by either assuming that data at the right semantic level is available, or they develop bespoke methods for capturing such data. Our recent Scene Graph Safety Monitoring (SGSM) framework addresses this challenge by extracting scene graphs (SGs) from sensor inputs to capture the entities related to the AV, specifying driving properties using a domain-specific language that enables building propositions over those graphs and composing them through temporal logic, and synthesizing monitors to detect property violations. Through this paper we further explain, formalize, analyze, and extend the SGSM framework, producing SGSM++. This extension is significant in that it incorporates the ability for the framework to encode the semantics of resetting a property violation, enabling the framework to count the quantity and duration of violations. We implemented SGSM++ to monitor for violations of 9 properties of 3 AVs from the CARLA Autonomous Driving Leaderboard, confirming the viability of the framework, which found that the AVs violated 71% of properties during at least one test including almost 1400 unique violations over 30 total test executions, with violations lasting up to 9.25 minutes. Artifact available at https://github.com/less-lab-uva/ExtendingSGSM. © 2024},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4; All Open Access; Bronze Open Access}
}

@CONFERENCE{Embarak2025457,
	author = {Embarak, Ossama},
	title = {A Behaviour-Driven Framework for Smart Education: Leveraging Explainable AI and IoB in Personalized Learning Systems},
	year = {2025},
	journal = {Procedia Computer Science},
	volume = {265},
	pages = {457 - 466},
	doi = {10.1016/j.procs.2025.07.205},
	url = {https://www.scopus.com/pages/publications/105015148459?origin=resultslist},
	abstract = {In the era of smart cities, the integration of adaptive technologies into education has become imperative to support remote, hybrid, and personalized learning models. This paper introduces an intelligent educational framework that combines Explainable Artificial Intelligence (XAI) with the Internet of Behaviour (IoB) to deliver responsive, behaviour-driven instruction tailored to diverse learner profiles. The study involved 41 undergraduate computing students whose behavioral data - collected via IoT-enabled tools and collaborative platforms was analysed to categorize learners into four segments: elite (16%), fair (34%), average (11%), and weak (39%). Initial results revealed that the system provided the highest support to weak students, a notable deviation from prior studies that favoured high performers. Following a second intervention cycle with personalized feedback, weak student support improved significantly to 56%, validating the model's adaptability and engagement efficacy. The XAI layer ensured transparency in system decisions by mapping behavioral indicators such as speaking, writing, collaboration, and volunteering to academic outcomes. The proposed framework not only enhances the interpretability of AI-driven education systems but also demonstrates scalable potential in fostering equity, inclusiveness, and cognitive personalization across smart learning environments.  © 2025 The Authors. Published by Elsevier B.V.},
