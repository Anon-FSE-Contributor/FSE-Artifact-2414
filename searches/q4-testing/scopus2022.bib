	doi = {10.1007/978-3-032-25035-3_24},
	url = {https://www.scopus.com/pages/publications/105047048999?origin=resultslist},
	abstract = {Behavior-driven development (BDD) facilitates collaboration through natural language specifications but remains difficult to adopt in practice, particularly for users without technical expertise. This paper presents BDDTestAIGen, a modular framework that integrates large language models (LLMs), natural language processing (NLP), and agent-based interaction to assist in the authoring of executable BDD tests. The method combines fine-tuned lightweight models with retrieval-augmented prompting, semantic role labeling, and human-in-the-loop correction to interpret user input and map it to parameterized step implementations. We evaluate the system on real-world game development scenarios involving technical and non-technical users, reporting metrics including partial match accuracy, time-to-first-match, and ablation studies on model components. Results indicate that compact models equipped with structured retrieval can support test creation workflows effectively, while preserving responsiveness and interpretability. The system architecture supports extensions to multilingual input, token-level attribution, and adaptive learning from user revisions. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2027.},
