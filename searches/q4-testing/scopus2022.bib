@ARTICLE{De Giacomo20141,
	author = {De Giacomo, Giuseppe and De Masellis, Riccardo and Grasso, Marco and Maggi, Fabrizio Maria and Montali, Marco},
	title = {Monitoring business metaconstraints based on LTL and LDL for finite traces},
	year = {2014},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
	volume = {8659 LNCS},
