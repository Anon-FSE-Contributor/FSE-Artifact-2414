@ARTICLE{Zhang2026,
	author = {Zhang, Zhenya and An, Jie and Arcaini, Paolo and Hasuo, Ichiro},
	title = {CauMon: A tool for online monitoring against signal temporal logic},
	year = {2026},
	journal = {Science of Computer Programming},
	volume = {253},
	pages = {},
	doi = {10.1016/j.scico.2026.103499},
	url = {https://www.scopus.com/pages/publications/105037872920?origin=resultslist},
	abstract = {CauMon is a tool for online monitoring against Signal Temporal Logic (STL). STL is a widely-adopted formalism for expressing temporal properties of cyber-physical systems (CPS). Given a CPS, online monitoring aims to assess its satisfaction against an STL specification at runtime. Existing online monitoring techniques mostly rely on robust semantics, which leads to the “information masking” problem and cannot precisely assess the system evolution. In comparison, CauMon adopts the causation semantics, which can deliver more faithful characterizations of system evolution. Moreover, the high efficiency of CauMon allows it to operate in an online fashion, while remaining scalable to handle complex STL specifications and long execution traces. © 2026 Elsevier B.V.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Chen202685,
	author = {Chen, Hao and Liu, Feiyang and Li, Bin and Li, Zhiyun and Zhang, Yunfei},
	title = {LLM/VLM-Driven Integrated Testing Framework for Autonomous Driving Assistance Systems: From Requirements to Failure Attribution},
	year = {2026},
	journal = {2026 7th International Conference on Mechatronics Technology and Intelligent Manufacturing, ICMTIM 2026},
	pages = {85 - 91},
	doi = {10.1109/ICMTIM69588.2026.11525613},
	url = {https://www.scopus.com/pages/publications/105041869478?origin=resultslist},
	abstract = {The validation of Advanced Driver Assistance Systems (ADAS) including Automatic Emergency Braking (AEB), Lane Keeping Assist (LKA), Adaptive Cruise Control (ACC), and Navigate on Autopilot (NOA) faces significant challenges in addressing complex weather conditions, irregular objects, dynamic interactions, and long-tail scenarios. This paper proposes a comprehensive Large Language Model (LLM) and Vision Language Model (VLM) driven testing methodology that integrates requirement understanding, scenario generation, risk coverage, test execution, result determination, and failure attribution into a unified framework. Our approach transforms natural language regulations, functional specifications, accident cases, and Operational Design Domain (ODD) constraints into structured testing knowledge graphs and executable scenario parameter spaces. We establish hierarchical validation loops through simulation, hardware-in-the-loop, and real-vehicle testing environments. To ensure reliability, we introduce verifiability design through formal constraints, scenario traceable encoding, coverage metrics, risk triggering conditions, and LLM output consistency validation. Rather than directly replacing testing decisions, LLMs serve as test case expanders, boundary condition discoverers, and failure interpreters. Experimental results demonstrate significant improvements: 87.3% scenario coverage compared to 52.7% for traditional methods, 34.2% improvement in risk detection sensitivity, and 68.5% increase in testing efficiency while maintaining 94.1% consistency validation accuracy. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Waga202559,
	author = {Waga, Masaki and Matsuoka, Kotaro and Suwa, Takashi and Matsumoto, Naoki and Banno, Ryotaro and Bian, Song and Suenaga, Kohei},
	title = {Oblivious Monitoring for Discrete-Time STL via Fully Homomorphic Encryption},
	year = {2025},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics) },
	volume = {15191 LNCS},
	pages = {59 - 69},
	doi = {10.1007/978-3-031-74234-7_4},
	url = {https://www.scopus.com/pages/publications/85207659900?origin=resultslist},
	abstract = {When monitoring a cyber-physical system (CPS) from a remote server, keeping the monitored data secret is crucial, particularly when they contain sensitive information, e. g., biological or location data. Recently, Banno et al. (CAV’22) proposed a protocol for online LTL monitoring that keeps data concealed from the server using Fully Homomorphic Encryption (FHE). We build on this protocol to allow arithmetic operations over encrypted values, e. g., to compute a safety measurement combining distance, velocity, and so forth. Overall, our protocol enables oblivious online monitoring of discrete-time real-valued signals against signal temporal logic (STL) formulas. Our protocol combines two FHE schemes, CKKS and TFHE, leveraging their respective strengths. We employ CKKS to evaluate arithmetic predicates in STL formulas while utilizing TFHE to process them using a DFA derived from the STL formula. We conducted case studies on monitoring blood glucose levels and vehicles’ behavior against the Responsibility-Sensitive Safety (RSS) rules. Our results suggest the practical relevance of our protocol. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@CONFERENCE{Behera2024,
	author = {Behera, Aishwaryarani and Acharya, Arup Abhinna and Mohanty, Sanjukta and Panda, Namita},
	title = {Designing a Multi-Class Classification Optimized Model for Requirement based Test Case Prioritization},
	year = {2024},
	journal = {Proceedings of 2nd International Conference on Advancements in Smart, Secure and Intelligent Computing, ASSIC 2024},
	pages = {},
	doi = {10.1109/ASSIC60049.2024.10507913},
	url = {https://www.scopus.com/pages/publications/85192981436?origin=resultslist},
	abstract = {Most of the times we have to test out the entire application functionality, for any code modification done to cater the need of the larger audiences or any bug fixes. This results to consumption of time and the effort to retest the application by executing all of the test suites. In such cases more often regression testing comes to the rescue, where prioritization techniques are being used to overcome the limitations of regression testing. Test Case Prioritization (TCP) usually means categorically ranking some test cases higher than others. The main goal of the TCP is to find the fault early in the testing process by scheduling the test cases with the help of Requirement based Test Case Prioritization Technique (RTCP) in order to increase effectiveness of regression testing. In this research study, we have developed a supervised machine learning based RTCP mechanism where the significant business requirement based relevant feature are considered for scheduling test cases according to their priority label as high, medium and low multi classes. The proposed model is validated with the two datasets collected from internet sources. The machine learning classifier k-Nearest Neighbor (K-NN), Decision Tree (DT), Random Forest (RF) Bagging and Boosting algorithm are utilized to evaluate the features for the test case prioritization. To enhance the performance of the model some hyper parameter settings are altered and found a drastic change in the results. To achieve the low cost and high fault detection rate in RTCP, an optimized model is designed which is validated by datasets and altered parameter settings. The experimental result demonstrates that RF classifier achieved the best performance among the other classifiers for predicting the prioritized test cases early to reduce the cost and time required for regression testing. © 2024 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

