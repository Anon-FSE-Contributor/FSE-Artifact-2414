@CONFERENCE{Niu202213,
	author = {Niu, Zhi and Dong, Luming and Zhu, Yong and Chen, Li},
	title = {Verifying Zookeeper based on Model-Based runtime Trace-Checking using TLA+},
	year = {2022},
	journal = {ACM International Conference Proceeding Series},
	pages = {13 - 18},
	doi = {10.1145/3558819.3558822},
	url = {https://www.scopus.com/pages/publications/85149938976?origin=resultslist},
	abstract = {Zookeeper atomic broadcast (Zab) is a atomic broadcast protocol specially designed for the distributed coordination service Zookeeper to support rout recovery. It is widely used in such scenarios as cluster management, load balancing and data publish and subscription. It is the core algorithm for ensuring Zookeeper data consistency. In this article, we design a Model-Based runtime Tracechecking system based on formal specification language TLA+ and its model checking tool TLC and use it to perform online verification against the behaviors of distributed Zookeeper cluster according to trace, which aims to monitor and check whether the actual execution of Zookeeper cluster complies with the Zab protocol specification. Firstly, stubs are added to relevant Zookeeper code modules which are synchronized with the implementation of Zab protocol state transitions to guarantee specific trace info generation and output to the target log file. Secondly, a formal model is built with TLA+ which can analyzes and specifies the state sequences info of Zookeeper cluster provided by trace, and the correctness and safety properties for this specification are also defined according to Zab protocol. A series of operators were also developed for TLC to load the trace info in history with different formats from the log files for model checking. The final experiment shows that this checking system can provide light-weighted and feasible formal method for verifying actual execution behaviors of distributed systems.  © 2022 ACM.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@CONFERENCE{Hoffmann2025,
	author = {Hoffmann, David and Ammana, Someshwar Reddy and Dsouza, Ashley Jason and Gudder, Ranjitkumar and Luder, Arndt},
	title = {Towards a Gherkin-Based Requirement Verification Approach in MBSE},
	year = {2025},
	journal = {ISSE 2025 - 11th IEEE International Symposium on Systems Engineering, Symposium Proceedings},
	pages = {},
	doi = {10.1109/ISSE65546.2025.11370125},
	url = {https://www.scopus.com/pages/publications/105035023616?origin=resultslist},
	abstract = {Model-Based Systems Engineering (MBSE) plays a critical role in managing complexity during early system development, yet verifying that architectural models satisfy stakeholder requirements remains a largely manual and error-prone task. While Behavior-Driven Development (BDD) has gained traction in software engineering by bridging the gap between natural language requirements and executable tests, its potential in the MBSE domain is underexplored. This paper introduces a novel methodology that adapts the Gherkin syntax from BDD into a constrained, graph-aware dialect tailored for MBSE applications. The approach formalizes the transformation of natural language requirements into structured, testable scenarios and verifies them against SysML-based architectural models represented as graphs. We demonstrate the method using a prototypical use case, illustrating how functional requirements can be traced, validated, and iteratively refined through test feedback. The methodology is tool-agnostic and supports multiple implementation strategies. By combining scenario-driven verification with model-based reasoning, the proposed MBSE-Gherkin framework fosters early, automated, and traceable validation of behavioral system requirements. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Martins2025,
	author = {Martins, Bruno and Patacas, Carlos and Cavaleiro, Albano and Faia, Pedro and Fernandes, Filipe},
	title = {Real-time temperature monitoring during titanium alloy machining with cutting tools integrating novel thin-film sensors},
	year = {2025},
	journal = {Mechanical Systems and Signal Processing},
	volume = {228},
	pages = {},
	doi = {10.1016/j.ymssp.2025.112444},
	url = {https://www.scopus.com/pages/publications/85217973453?origin=resultslist},
	abstract = {This study explores the integration of titanium aluminum nitride (TiAlN) and zirconium aluminum nitride (ZrAlN) thin-film sensors into cutting tools for real-time temperature monitoring during machining of Ti6Al4V titanium alloy. These sensors, integrated into a multilayer coating for electrical and wear shielding, were deposited directly onto the tool surfaces and calibrated for temperatures up to 750 °C. Due to the integration into the multilayer coating, the sensors exhibit different β sensitivities across the temperature range, ranging from 108 to 825 K for TiAlN and from 950 to 6681 K for ZrAlN. The cutting tests conducted under various cutting conditions, such as cutting speed, feed rate, depth of cut, and cooling, revealed the influence of these parameters on the cutting temperature. Our findings indicate that the sensor position in the tool's rake face is fundamental for measuring the cutting temperature. The study introduces an innovative tool connector for integration and signal retrieval of the cutting tool in a “plug-and-play” fashion, compatible with industry standards. Additionally, implementing wireless data transmission for real-time and in-situ temperature monitoring offers a pathway for integrating smart cutting tools into modern manufacturing environments, aligning with Industry 4.0. © 2025 Elsevier Ltd},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 17}
}

