}

@BOOK{Grosch201388,
	author = {Grosch, Vanessa},
	title = {Requirements traceability within model-based testing: Applying path fragments and temporal logic},
	year = {2013},
	journal = {Adoption and Optimization of Embedded and Real-Time Communication Systems},
	pages = {88 - 107},
	doi = {10.4018/978-1-4666-2776-5.ch005},
	url = {https://www.scopus.com/pages/publications/84949509155?origin=resultslist},
	abstract = {Requirements traceability enables the linkage between all development artifacts during the development process. Within model-based testing, requirements traceability links the original requirements with test model elements and generated test cases. Current approaches are either not practical or lack the necessary formal foundation for generating requirements-based test cases using model-checking techniques involving the requirements trace. This paper describes a practical and formal approach to ensure requirements traceability. The descriptions of the requirements are defined on path fragments of timed automata or timed state charts. The graphical representation of these paths is called a computation sequence chart (CSC). CSCs are automatically transformed into temporal logic formulae. A model-checking algorithm considers these formulae when generating test cases. © 2013 by IGI Global. All rights reserved.},
