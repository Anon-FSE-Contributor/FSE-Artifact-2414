@CONFERENCE{Agbo202554,
	author = {Agbo, Chidi and Mehrpouyan, Hoda},
	title = {Enhancing Resilience in Industrial Control Systems: Rapid Attack Detection, Recovery, and Monotonicity Preservation Through STL-GT Online Monitoring},
	year = {2025},
	journal = {Proceedings - 2025 IEEE 7th International Conference on Trust, Privacy and Security in Intelligent Systems, and Applications, TPS-ISA 2025},
	pages = {54 - 65},
	doi = {10.1109/TPS-ISA67132.2025.00016},
	url = {https://www.scopus.com/pages/publications/105036521641?origin=resultslist},
	abstract = {This paper addresses the pressing challenges of building secure and resilient Industrial Control Systems (ICS) by focusing on rapid attack detection, recovery, and maintaining monotonicity in online monitoring systems. Traditional methods often fail to quickly identify threats, leaving systems vulnerable to prolonged downtime. Specifically, classical online monitoring systems struggle to preserve monotonicity, as they typically detect only isolated anomalies during operation, which can mask subsequent deviations in system behavior. This research presents an advanced approach to resilient cyber-physical systems (CPS) that utilizes Signal Temporal Logic with Global Time (STL-GT) in combination with an Autotuning mechanism for robust realtime monitoring, multi-point anomaly detection, and recovery. This innovative framework enables prompt detection of attacks and faults, along with rapid system recovery. Our STL-GT online monitoring system incorporates a syntactic separation technique based on a partition rule to address monotonicity issues and improve the system's ability to detect and respond to multiple anomalies during system execution. The autotuning mechanism, based on Internal Model Control (IMC) PID tuning rules, enables swift and adaptive system recovery in the event of disruptions. We validated our methodology using the Tennessee Eastman Plant model, a complex chemical plant simulator designed to study industrial processes and control systems. Experimental results demonstrate that our approach provides effective security and resilience of the CPS by consistently detecting anomalies and restoring the system with zero overshoot and minimal oscillations, eliminating violation masking and missed alarms. These findings highlight the effectiveness of our approach in fortifying critical systems against adversarial attacks and operational faults.  © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Youn20251403,
	author = {Youn, Dongjun and Shin, Wonho and Ryu, Sukyoung},
	title = {WEST: Specification-Based Test Generation for WebAssembly},
	year = {2025},
	journal = {Proceedings - 2025 40th IEEE/ACM International Conference on Automated Software Engineering, ASE 2025},
	pages = {1403 - 1414},
	doi = {10.1109/ASE63991.2025.00119},
	url = {https://www.scopus.com/pages/publications/105034668796?origin=resultslist},
	abstract = {WebAssembly (Wasm) is a low-level binary instruction format designed for safe and high-performance execution across diverse computing environments and runtimes. As Wasm evolves with new features and proposals, testing the correctness and conformance of Wasm runtimes has become increasingly complex. Manually constructing test suites is labor-intensive and difficult to scale, especially as the specification grows in complexity. While fuzzing-based approaches offer partial automation, they often lack a principled connection to the formal specification, and adapting to evolving or restricted subsets of the specification typically requires manual intervention.In this paper, we present WEST, a specification-based test generation framework that automatically produces Wasm test cases from mechanized specifications written in SpecTec, a Wasm-specific specification language. Given any full or subset variant of the Wasm specification as input, WEST aims to systematically generate test programs that conform to the input grammar and validation rules, and capture the runtime behavior defined by its execution semantics. The framework allows flexible integration of different test generation strategies. For instance, we demonstrate both top-down and bottom-up approaches for generating Wasm modules, but the architecture is compatible with other generation techniques as well. The framework enables the creation of customized test cases for engines that support only subsets of the Wasm specification. We evaluate WEST across multiple specification variants and engine configurations, demonstrating that it produces valid and diverse test cases. As a result, it reveals 16 bugs across four Wasm engine implementations, 11 of which are confirmed and fixed. We believe that this work provides a solid foundation for future specification-driven test generation. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Ren2023239,
	author = {Ren, Zhong and Qin, Xianrong and Zhang, Qing and Sun, Yuantao},
	title = {Damage Evolution Characterization of Low Carbon Alloy Steel Based on Multiaxial Fatigue Test and DIC},
	year = {2023},
	journal = {2023 IEEE International Conference on Prognostics and Health Management, ICPHM 2023},
	pages = {239 - 245},
	doi = {10.1109/ICPHM57936.2023.10194231},
