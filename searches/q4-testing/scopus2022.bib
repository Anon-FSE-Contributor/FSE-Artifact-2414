	year = {2025},
	journal = {2025 4th International Conference on Energy Internet and Power Systems, ICEIPS 2025},
	pages = {350 - 354},
	doi = {10.1109/ICEIPS67524.2025.11380943},
	url = {https://www.scopus.com/pages/publications/105035528614?origin=resultslist},
	abstract = {The operational safety of lead-cooled fast reactors (LFRs) is highly dependent on the corrosion resistance of structural materials, and this performance is primarily regulated by dissolved oxygen concentration. To support decision-making for oxygen concentration control, this study proposes an oxygen electromotive force (EMF) prediction method that integrates multi-dimensional information, incorporating variational mode decomposition (VMD), Pearson correlation coefficient (PCCs), convolutional neural network (CNN), and bidirectional gated recurrent unit (BiGRU). The specific workflow is as follows: First, the temperature feature sequence is decomposed using VMD to convert the complex nonlinear time series into simple components. These components are then screened via PCC to select those highly correlated with the target oxygen EMF, and the selected components are processed by CNN for feature extraction. Meanwhile, the original sequence is input into BiGRU for feature extraction. Finally, the two sets of features are fused to output oxygen EMF values for a future period, providing support for oxygen concentration control. The experimental data were obtained from the lead-bismuth eutectic (LBE) loop facility. Comparative analysis shows that the proposed model maintains high accuracy across different prediction horizons. Compared with the Transformer model, it achieves average improvements of 45.55% in RMSE, 53.27% in MAE, and 10.23% in R<sup>2</sup>. The results demonstrate that this hybrid method can effectively address the complexity of multi-feature sequences and exhibits significant potential for practical application. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Irfan2022556,
