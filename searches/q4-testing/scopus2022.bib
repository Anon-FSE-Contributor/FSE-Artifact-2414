@ARTICLE{Ding2026,
	author = {Ding, Yixian and Liu, Yueming and Nie, Meng and Wang, Wenxi and Zhu, Hongtao and Han, Defu},
	title = {Cross-specification abrasive belt wear monitoring: a physics-informed deep learning framework with acoustic emission burst indicator},
	year = {2026},
	journal = {Mechanical Systems and Signal Processing},
	volume = {258},
	pages = {},
	doi = {10.1016/j.ymssp.2026.114734},
	url = {https://www.scopus.com/pages/publications/105045127865?origin=resultslist},
	abstract = {In abrasive belt grinding, multi-stage polishing commonly involves switching between belts of different grit sizes, which can reduce the predictive accuracy of data-driven wear monitoring models. Moreover, existing acoustic-emission (AE)-based monitoring methods often rely on intensity-oriented features that are not specifically designed to capture wear-sensitive burst morphology. To address these issues, this study proposes a physics-informed deep learning framework for cross-specification abrasive belt wear monitoring. A theoretical model linking grain geometry evolution, contact mechanics, and multi-mode energy partition is established to characterize AE generation during abrasive belt grinding. To capture the transition from efficient micro-cutting to ploughing and frictional sliding, a novel AE burst indicator, termed the cumulative impulse density-duration ratio (CIDDR), is introduced. This feature captures the statistical evolution of AE burst characteristics, providing a physically interpretable proxy for the progressive loss of cutting effectiveness. Subsequently, the framework employs a denoising-aware Stacked Sparse Auto-Encoder (SSAE) to extract compact latent representations from these physics-enhanced inputs, followed by a Physics-informed Causal Temporal Convolutional Network (PI-CTCN) regularized by physics-informed loss to ensure physically consistent wear monitoring. To achieve cross-specification generalization, a parameter-based transfer learning strategy adapts the learned representations to belt-induced domain shifts through selective fine-tuning. Experimental validation on two belt specifications (A45 and A160) grinding TC4 titanium alloy (Ti-6Al-4 V) demonstrates that the proposed framework achieves an RMSE of 33.54 mg and R<sup>2</sup> of 0.9857 in the A160-to-A45 transfer case. These results confirm the effectiveness of the proposed framework for accurate, interpretable, and physically consistent cross-specification wear monitoring. © 2026 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
