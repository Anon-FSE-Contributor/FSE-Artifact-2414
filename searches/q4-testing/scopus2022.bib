	doi = {10.1109/JIOT.2026.3665536},
	url = {https://www.scopus.com/pages/publications/105030707258?origin=resultslist},
	abstract = {The rapid growth of the social Internet of Things (SIoT) and digital twin (DT) technologies in smart homes, healthcare, and industrial automation has created complex networks that demand robust security measures. Integrating these technologies into social Internet of DT Things (SIDTTs) ecosystems faces security challenges, primarily due to an open attack surface and inadequate real-time risk assessment frameworks. Current solutions often lack comprehensive integration of contextual information and user behavior analytics, leading to potential privacy issues and inefficient security measures. To address these gaps, this research proposes a novel behavior-driven real-time risk assessment framework. It introduces a context-aware federated access control and authorization (CA-FA-CA) framework that leverages federated learning with long short-term memory (LSTM) networks for user behavior analysis and isolation forest (IF) for anomaly detection. In addition, an adaptive risk-based access control that comes under artificial intelligence (AI) driven cybersecurity, known as real-time deep reinforced risk score assessment framework, which combines reinforced generative adversarial networks (RRS-GANs) with deep Q-network (DQN) and adaptive multifactor (AMF) authentication, is introduced for dynamically adjusting risk scoring and authentication measures. This comprehensive approach ensures enhanced security and user experience by continuously adapting to real-time data and evolving threats, giving an Accuracy of 98.2% and a throughput of about 1023 transactions per second (TPS), while overcoming the limitations of existing methods in SIDTT ecosystems. © 2014 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@ARTICLE{Cunha2026279,
	author = {Cunha, Alcino and Macedo, Nuno},
	title = {Validating Formal Specifications with LLM-Generated Test Cases},
	year = {2026},
	journal = {Lecture Notes in Computer Science},
	volume = {16556 LNCS},
