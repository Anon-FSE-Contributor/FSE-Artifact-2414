@ARTICLE{Thati2005145,
	author = {Thati, Prasanna and Rou, Grigore},
	title = {Monitoring Algorithms for Metric Temporal Logic Specifications},
	year = {2005},
	journal = {Electronic Notes in Theoretical Computer Science},
	volume = {113},
	number = {SPEC. ISS.},
	pages = {145 - 162},
	doi = {10.1016/j.entcs.2004.01.029},
	url = {https://www.scopus.com/pages/publications/11344251138?origin=resultslist},
