@ARTICLE{Gai20246149,
	author = {Gai, Tiantian and Wu, Jian and Chiclana, Francisco and Cao, Mingshuo and Yager, Ronald R.},
	title = {Dynamic Compromise Behavior Driven Bidirectional Feedback Mechanism for Group Consensus with Overlapping Communities in Social Network},
