	note = {Cited by: 178; All Open Access; Green Open Access}
}

@ARTICLE{Enoiu2016335,
	author = {Enoiu, Eduard P. and Čaušević, Adnan and Ostrand, Thomas J. and Weyuker, Elaine J. and Sundmark, Daniel and Pettersson, Paul},
	title = {Automated test generation using model checking: an industrial evaluation},
	year = {2016},
	journal = {International Journal on Software Tools for Technology Transfer},
	volume = {18},
