@ARTICLE{Cimatti202570,
	author = {Cimatti, Alessandro and Grosen, Thomas M. and Larsen, Kim G. and Tonetta, Stefano and Zimmermann, Martin},
	title = {Exploiting Assumptions for Effective Monitoring of Real-Time Properties Under Partial Observability},
