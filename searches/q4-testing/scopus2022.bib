@CONFERENCE{Molinelli2025278,
	author = {Molinelli, Davide and Grazia, Luca Di and Martin-Lopez, Alberto and Ernst, Michael D. and Pezze, Mauro},
	title = {Do LLMs Generate Useful Test Oracles? An Empirical Study with an Unbiased Dataset},
	year = {2025},
