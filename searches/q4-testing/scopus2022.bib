@CONFERENCE{Jovanovic2023228,
	author = {Jovanovic, Ana and Sullivan, Allison},
	title = {Mutation Testing for Temporal Alloy Models},
	year = {2023},
	journal = {Proceedings - ACM/IEEE 26th International Conference on Model Driven Engineering Languages and Systems, MODELS 2023},
