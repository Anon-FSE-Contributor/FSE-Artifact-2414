	pages = {655 - 664},
	url = {https://www.scopus.com/pages/publications/105048808786?origin=resultslist},
	abstract = {This study introduces Moonflower, a multi-agent simulation component developed in Grasshopper to model how humans and movable outdoor furniture adapt to dynamic solar-shade conditions. While architectural simulations commonly treat shade as an environmental performance parameter, this study positions shade as a behavioural attractor that influences spatial occupation and micro-scale reconfiguration. The research addresses a gap between human-centred agent-based models and environmental analysis workflows by asking how the integration of human and non-human agents can represent adaptive outdoor behaviour in a computationally explicit manner. The methodology combines Ladybug-driven solar simulations (a climate and environmental analysis plugin for Grasshopper) with a custom C#- based agent system, enabling people, tables, chairs, and temporally shifting shade zones to interact within a unified computational environment. A field study conducted at Istanbul Technical University, Faculty of Architecture (Taşkışla Campus) provides empirical observations of daily shade-driven relocation patterns, which are used to inform and contextualise model calibration. Results demonstrate that furniture movements are strongly correlated with the temporal progression of shaded areas, leading to distinct patterns of spatial use and comfort over time. By explicitly linking environmental conditions with behavioural adaptation, Moonflower provides a framework for designing responsive and climate-aware public spaces. © 2026 and published by the Association for Computer-Aided Architectural Design Research in Asia (CAADRIA), Hong Kong.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Akande2025,
	author = {Akande, Ayodeji James and Hou, Zhe and Foo, Ernest and Li, Qinyi},
	title = {LTL-based runtime verification framework for cyber-attack anomaly prediction in cyber–physical systems},
	year = {2025},
	journal = {Computers and Security},
	volume = {155},
	pages = {},
	doi = {10.1016/j.cose.2025.104455},
	url = {https://www.scopus.com/pages/publications/105002236663?origin=resultslist},
	abstract = {An anomaly is any unexpected or abnormal behaviour, event, or data pattern within a network of physical and computational components caused by data errors, cyber-attacks, hardware failures, or other unforeseen events. Anomaly detection analyses events after they occur, while anomaly prediction forecasts them before they manifest. The increasing complexity of Cyber-Physical Systems (CPS) presents challenges in fault management and vulnerability to advanced attacks, highlighting the need for early intervention through anomaly prediction. Existing anomaly prediction methods often fail due to a lack of formal guarantees required for safety-critical applications. In this paper, we introduce our anomaly prediction framework which merges the advantages of data analytics and the derivation of Linear Temporal Logic (LTL) formulas. LTL-based runtime monitoring and checking is a well-established technique efficient for tackling challenges in real-time and promptly. The framework processes historical data, clusters them to extract predictive patterns, and forms data sequences that represent these trends. These sequences are fed into an LTL learning algorithm to produce a formula that represents the pattern. This formula functions as a security property programmed into a runtime checker to verify system correctness and predict the possibility of anomalies. We evaluated our framework using three datasets collected from a cyber-physical system testbed and the experimental findings demonstrate a minimum accuracy of 90% in predicting anomalies. © 2025},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Ferreira202541,
	author = {Ferreira, José João and Policarpo, Nuno and Santos, José Fragoso and Cunha, Alcino and Gianola, Alessandro},
	title = {First-Order Linear Temporal Logic for Testing Distributed Protocols},
	year = {2025},
