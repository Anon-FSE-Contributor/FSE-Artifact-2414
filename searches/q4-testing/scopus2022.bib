@CONFERENCE{Berral2021404,
	author = {Berral, Josep Lluis and Buchaca, David and Herron, Claudia and Wang, Chen and Youssef, Alaa},
	title = {Theta-Scan: Leveraging Behavior-Driven Forecasting for Vertical Auto-Scaling in Container Cloud},
	year = {2021},
	journal = {IEEE International Conference on Cloud Computing, CLOUD},
	volume = {2021-September},
