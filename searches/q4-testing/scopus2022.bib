@ARTICLE{Lan2026,
	author = {Lan, Zeying and Lu, Beixi and Bian, Yuyi and Liu, Yang and Chen, Xiaohui and He, Jianhua},
	title = {Resident Behavior-Driven Zonation and Optimization of Commercial Service Facilities at the Community Scale},
	year = {2026},
	journal = {Smart Cities},
	volume = {9},
	number = {5},
	pages = {},
	doi = {10.3390/smartcities9050084},
	url = {https://www.scopus.com/pages/publications/105040003935?origin=resultslist},
	abstract = {Precise assessment of commercial service facilities (CSFs) is a vital pillar for megacity governance. However, existing evaluations rely on static population and 2D metrics, overlooking behavioral heterogeneity and 3D spatial supply at the micro scale. This study constructs a “3D Supply–Group Demand–Matching” framework at the community level. On the supply side, a Building Coupling Entropy (BCE) model integrates 3D volume and morphology to characterize service capacity. On the demand side, a dynamic behavioral model measures multi-group needs. Mismatch patterns are identified using the Entropy-modified Spatial Disparity Ratio (ESDR). Using Guangzhou as a case, the results reveal three paradigms: (1) Core districts exhibit rigid path dependency, where first-tier sub-districts rose from 48 to 51, and elderly service shortages in old areas plummeted by nearly 80% via micro-regeneration; (2) Growth poles show spatial fragmentation, with core labor demand spilling over but infrastructure lagging, creating a fast production–slow urbanism mismatch; (3) Far-suburban areas reduced extreme-shortage sub-districts from 38 to 34, identifying resource islands besieged by residential demand. Overall, the framework elucidates the shape–flow mismatch mechanism and provides a transferable basis for precision zonation governance, supporting a shift from static quantity-based allocation to dynamic quality-oriented provision in high-density megacities. © 2026 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Babu2026942,
	author = {Babu, Selva B. and Kumar, Bubesh D. and Prabhu, L. and Sathiyaraj, S.},
	title = {FINITE ELEMENT ANALYSIS AND MECHANICAL TESTING OF TITANIUM ALLOY (TI-6AL-4V) AND SILICON CARBIDE (SIC) FOR HIP IMPLANTS},
	year = {2026},
	journal = {Journal of Engineering and Technology for Industrial Applications},
	volume = {12},
	number = {59},
	pages = {942 - 950},
	doi = {10.5935/jetia.v12i58.3791},
	url = {https://www.scopus.com/pages/publications/105040162425?origin=resultslist},
	abstract = {Orthopedic surgical implants have traditionally been produced using conventional manufacturing techniques, with the output of these methods depending on the weight of the fabricated component and its biologically sourced materials. These hip implant composites, when exposed to physiological conditions over extended periods, particularly blood and adjacent soft tissues, are susceptible to gradual material degradation, manifesting as corrosion-induced damage and structural compromises. To address these challenges, this study focused on the development of titanium-containing composite material devices, primarily incorporating silicon carbide as a supporting component. The devices were cast via high-temperature sintering, facilitated by a specialized die assembly. The geometric design, material composition, and dimensional precision of these die sets are critical factors that determine the compressing efficiency and, consequently, the quality of the resulting sintered products. Therefore, this study emphasizes the design and application of a sintering die set optimized for cold uniaxial compression to produce cylindrical green packs characterized by a consistent layout and sufficient mechanical strength before the heated compression process. The compaction die set is a crucial component of the powder metallurgy method, which is responsible for shaping loose powder into the intended form. The die set was designed in accordance with the ASTM standards, and AISI D3 steel was used for its fabrication. This study also elaborates on the design factors, calculations, 2-D drawings, and 3-D models related to the die set. The die was manufactured using processes such as facing, turning, drilling, grinding, wire-cut electrical discharge machining (EDM), and heat treatment. The design was analyzed using SolidWorks 14 and ANSYS 2023R1. Following the evaluation of the safe load and production of the die set, the specimens were characterized. Scanning electron microscopy (SEM) evaluation identified the grain boundaries and porosity of the material, and mechanical tests demonstrated satisfactory hardness and biocompatibility.. © 2026 by authors and Galileo Institute of Technology and Education of the Amazon (ITEGAM).},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
