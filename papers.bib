@inproceedings{Carvalho2023Acore,
  title = {ACoRe: Automated Goal-Conflict Resolution},
  author = {Carvalho, Luiz and Degiovanni, Renzo and Brizzio, Matías and Cordy, Maxime and Aguirre, Nazareno and Traon, Yves Le and Papadakis, Mike},
  year = {2023},
