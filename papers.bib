@inproceedings{Hu2021Multidimensional,
  title = {Multidimensional Uncertainty-Aware Evidential Neural Networks},
  author = {Hu, Yibo and Ou, Yuzhe and Zhao, Xujiang and Cho, Jin-Hee and Chen, Feng},
  year = {2021},
