@article{Priyadi2026Traceable,
  title = {Traceable Reverse Engineering of UML Artifacts from SRS/SDD Documents Using NLP-Based Text Processing and Siamese BiLSTM: An IdVar4CL Case Study},
  author = {Priyadi, Yudi and Darwiyanto, Eko and Nurtantyana, Rio},
  year = {2026},
  journal = {Ingenierie des Systemes d'Information},
