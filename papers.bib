@inproceedings{Elrakaiby2017Using,
  title = {Using Argumentation to Explain Ambiguity in Requirements Elicitation Interviews},
  author = {Elrakaiby, Yehia and Ferrari, Alessio and Spoletini, Paola and Gnesi, Stefania and Nuseibeh, Bashar},
  year = {2017},
  booktitle = {Proceedings - 2017 IEEE 25th International Requirements Engineering Conference, RE 2017},
