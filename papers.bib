@inproceedings{Takamoto2026What,
  title = {What Domain Knowledge Do AI Agents Need for Requirements Analysis? an Empirical Study on Requirements Consistency Verification in Industry},
  author = {Takamoto, Hiroki and Ushida, Yoshiyasu and Iwashima, Keiichi and Kuroda, Akira and Nakae, Toshihiro},
