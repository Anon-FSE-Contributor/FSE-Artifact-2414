@inproceedings{Cheng2026Quare,
  title = {QUARE: Quality-Aware Requirements Analysis Through Multi-Agent Dialectical Negotiation},
  author = {Cheng, Haowei and Kim, Milhan and Khomh, Foutse and Racharak, Teeradaj and Yoshioka, Nobukazu and Ubayashi, Naoyasu and Washizaki, Hironori},
