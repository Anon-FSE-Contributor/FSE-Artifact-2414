@inproceedings{Meusel2026Brief,
  title = {Brief Announcement: Revisiting the Realizability of Periodic Temporal Graphs with Bounded Stretch},
  author = {Meusel, Julia and Morawietz, Nils and Müller-Hannemann, Matthias and Reinhardt, Klaus},
  year = {2026},
  booktitle = {Leibniz International Proceedings in Informatics, LIPIcs},
  volume = {373},
