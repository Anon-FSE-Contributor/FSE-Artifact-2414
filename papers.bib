@article{Cheng2026Argre,
  title = {ArgRE: Formal Argumentation for Conflict Resolution in Multi-Agent Requirements Negotiation},
  author = {Cheng, Haowei and Kim, Milhan and Liu, Chong and Racharak, Teeradaj and Duy, Truong Vinh Truong and Thanh, Phan Thi Huyen and Li, Jialong and Ubayashi, Naoyasu and Washizaki, Hironori},
