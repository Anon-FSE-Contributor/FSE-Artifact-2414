@inproceedings{Liu2026Framework,
  title = {A Framework to Identify Functional Consistency Issue between User Requirements Specifications and Software Requirements Specifications},
  author = {Liu, Haitao and Longani, Pattama},
  year = {2026},
  booktitle = {2026 8th International Conference on Natural Language Processing, ICNLP 2026},
  pages = {554 - 560},
  doi = {10.1109/icnlp69856.2026.11527516},
  url = {https://doi.org/10.1109/icnlp69856.2026.11527516},
  abstract = {In large-scale software engineering, functional consistency issues between User Requirements Specifications (URS) and Software Requirements Specifications (SRS) often lead to implementation deviations and rework. However, semantic sparsity, syntactic variations, and domain terminology diversity make reliable consistency identification extremely challenging. To address this issue, we propose a method that combines multi-level semantic similarity computation with logical constraints. This method first uses a semantic similarity gate based on SentenceBERT embeddings to capture high-level semantic equivalence; Then, BM25 and lexical semantics are used to model term-level relevance and identify latent semantic correspondences between heterogeneous requirement expressions. To adapt to the specific characteristics of the datasets, a sliding threshold is introduced at each stage, enabling adaptive decision boundaries across different datasets. Finally, logical constraints are used to identify whether functional consistency issues exist in the requirements. Experimental results on four different datasets demonstrate that the proposed framework effectively balances precision and recall, achieving good performance on multiple evaluation metrics, including F1 score and Matthews' correlation coefficient. The results confirm that our method can significantly improve the performance of functional consistency detection. © 2026 IEEE.},
  annote = {rank 243; cited by 0 papers of the pool (0.00 per year); cites 4 papers of the pool; notions: Consistency; R00331}
}

