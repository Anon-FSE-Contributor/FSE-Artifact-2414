@article{Gambo2026Mining,
  title = {Mining conflicting opinions from user reviews: a semantic rule-based framework for software requirements engineering},
  author = {Gambo, Ishaya and Enitilo, Solagbade Ayodele and Massenon, Rhodes and Khan, Javed Ali and Alwadain, Ayed and Agarwal, Saurabh},
  year = {2026},
