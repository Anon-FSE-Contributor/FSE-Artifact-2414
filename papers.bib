@inproceedings{Kim2026Third,
  title = {Toward Third-Party Assurance of AI Systems: Design Requirements, Prototype, and Early Testing},
  author = {Kim, Rachel M. and Kuehnert, Blaine and Lai, Alice and Holstein, Kenneth and Heidari, Hoda and Ghani, Rayid},
  year = {2026},
  booktitle = {Proceedings of the 2026 ACM Conference on Fairness, Accountability, and Transparency},
