@inproceedings{Zhang2025Eteltlf,
  title = {ETELTLf: A Recursive Embedding Approach for LTLf Satisfiability Checking in CPSs},
  author = {Zhang, Luxi and Mei, Yuxin and Han, Xu and Liu, Jing},
