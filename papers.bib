@inproceedings{Chitnis2024Autoref,
  title = {AutoRef: Generating Refinements of Reviews Given Guidelines},
  author = {Chitnis, Soham and Patwardhan, Manasi and Srinivasan, Ashwin and Verlekar, Tanmay Tulsidas and Vig, Lovekesh and Shroff, Gautam},
  year = {2024},
